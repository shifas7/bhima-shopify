<utility-bar-{{ ai_gen_id }} class="ai-utility-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-utility-bar-container-{{ ai_gen_id }}">
    <div class="ai-utility-bar-left-{{ ai_gen_id }}">
      {% if block.settings.store_locations_text != blank and block.settings.store_locations_link != blank %}
        <a href="{{ block.settings.store_locations_link }}" class="ai-utility-bar-link-{{ ai_gen_id }}">
          <span class="ai-utility-bar-icon-{{ ai_gen_id }}" aria-hidden="true">{% render 'icon-pin' %}</span>
          <span>{{ block.settings.store_locations_text }}</span>
        </a>
      {% endif %}

      {% if block.settings.phone_number != blank %}
        <a href="tel:{{ block.settings.phone_number | replace: ' ', '' | replace: '-', '' }}" class="ai-utility-bar-phone-{{ ai_gen_id }}">
          <span class="ai-utility-bar-icon-{{ ai_gen_id }}" aria-hidden="true">{% render 'icon-phone' %}</span>
          <span>{{ block.settings.phone_number }}</span>
        </a>
      {% endif %}
    </div>

    <div class="ai-utility-bar-center-{{ ai_gen_id }}">
      {% if block.settings.announcement_text != blank %}
        <p class="ai-utility-bar-announcement-{{ ai_gen_id }}"><i class="rbb-icon-delivery-1" aria-hidden="true"></i><span>{{ block.settings.announcement_text }}</span></p>
      {% endif %}

      {% if block.settings.custom_page_text != blank and block.settings.custom_page_link != blank %}
        <a href="{{ block.settings.custom_page_link }}" class="ai-utility-bar-link-{{ ai_gen_id }}">
          {{ block.settings.custom_page_text }}
        </a>
      {% endif %}
    </div>

    <div class="ai-utility-bar-right-{{ ai_gen_id }}">
      {% assign has_rates = false %}
      {% for i in (1..8) %}
        {% assign rate_label_key = 'rate_' | append: i | append: '_label' %}
        {% assign rate_price_key = 'rate_' | append: i | append: '_price' %}
        {% assign rate_price = block.settings[rate_price_key] %}
        {% if rate_price != blank %}
          {% assign has_rates = true %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% if has_rates %}
        <div class="ai-utility-bar-rate-viewport-{{ ai_gen_id }}" role="region" aria-label="Live metal rates">
          <div class="ai-utility-bar-rate-ticker-{{ ai_gen_id }}" id="metal-rates-menu-{{ ai_gen_id }}">
            <!-- Static fallback rates (shown while loading or if API fails) -->
            {% for i in (1..8) %}
              {% assign rate_label_key = 'rate_' | append: i | append: '_label' %}
              {% assign rate_price_key = 'rate_' | append: i | append: '_price' %}
              {% assign rate_label = block.settings[rate_label_key] %}
              {% assign rate_price = block.settings[rate_price_key] %}
              
              {% if rate_price != blank %}
                <div class="ai-utility-bar-rate-item-{{ ai_gen_id }} static-rate-item" data-rate-index="{{ i }}">
                  <span class="ai-utility-bar-rate-label-{{ ai_gen_id }}">{{ rate_label }}</span>
                  <span class="ai-utility-bar-rate-price-{{ ai_gen_id }}">{{ rate_price }}</span>
                </div>
              {% endif %}
            {% endfor %}
            <!-- Dynamic rates will be inserted here by JavaScript -->
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</utility-bar-{{ ai_gen_id }}>

<script>
  (function() {
    class UtilityBar{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.apiUrl = '{{ block.settings.api_url | default: "https://bhima-price-calculator-9njho.ondigitalocean.app/api/metal-prices/formatted" }}';
        this.ratesMenu = null;
        this.ratesLoaded = false;
      }

      connectedCallback() {
        this.ratesMenu = this.querySelector('#metal-rates-menu-{{ ai_gen_id }}');
        if (this.ratesMenu) {
          this.syncTicker();
          this.loadMetalPrices();
        }
      }

      syncTicker() {
        const existingClones = this.ratesMenu.querySelectorAll('[data-rate-clone="true"]');
        existingClones.forEach((clone) => clone.remove());

        const rateItems = Array.from(
          this.ratesMenu.querySelectorAll('.ai-utility-bar-rate-item-{{ ai_gen_id }}')
        ).filter((item) => item.dataset.rateClone !== 'true' && item.style.display !== 'none');

        rateItems.forEach((item) => {
          const clone = item.cloneNode(true);
          clone.dataset.rateClone = 'true';
          clone.setAttribute('aria-hidden', 'true');
          this.ratesMenu.appendChild(clone);
        });

        this.ratesMenu.classList.toggle('is-looping', rateItems.length > 0);
      }

      async loadMetalPrices() {
        if (this.ratesLoaded) return;
        
        try {
          const response = await fetch(this.apiUrl);
          const result = await response.json();
          
          if (result.success && result.data && result.data.formatted) {
            // Hide static rates
            const staticRates = this.ratesMenu.querySelectorAll('.static-rate-item');
            staticRates.forEach(rate => rate.style.display = 'none');
            
            // Clear and populate with dynamic rates
            const existingDynamic = this.ratesMenu.querySelectorAll('.dynamic-rate-item');
            existingDynamic.forEach(rate => rate.remove());
            
            result.data.formatted.forEach(rate => {
              const rateItem = document.createElement('div');
              rateItem.className = 'ai-utility-bar-rate-item-{{ ai_gen_id }} dynamic-rate-item';
              rateItem.innerHTML = `
                <span class="ai-utility-bar-rate-label-{{ ai_gen_id }}">${rate.label}</span>
                <span class="ai-utility-bar-rate-price-{{ ai_gen_id }}">${rate.price}</span>
              `;
              this.ratesMenu.appendChild(rateItem);
            });

            this.syncTicker();
            
            this.ratesLoaded = true;
          }
        } catch (error) {
          console.warn('Failed to load metal prices from API, using static rates:', error);
          // Keep static rates visible if API fails
        }
      }
    }
    customElements.define('utility-bar-{{ ai_gen_id }}', UtilityBar{{ ai_gen_id }});
  })();
</script>

