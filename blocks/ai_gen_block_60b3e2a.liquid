    },
    {
      "type": "header",
      "content": "Category label"
    },
    {
      "type": "range",
      "id": "category_title_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Title size",
      "default": 17
    },
    {
      "type": "select",
      "id": "category_title_weight",
      "label": "Title weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "color",
      "id": "category_title_color",
      "label": "Title color",
      "default": "#FFFDF9"
    },
    {
      "type": "color",
      "id": "category_title_hover_color",
      "label": "\"Explore\" text color",
      "default": "#F3E0BE"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section top padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section bottom padding",
      "default": 50
