{% doc %}
  @prompt
    Redesign "Shop by Category" from circular icon cards into a premium
    square editorial image grid (luxury jewellery ecommerce look):
    square image-led tiles, minimal border, overlaid warm gradient +
    uppercase label, gold-border hover with an "Explore →" reveal.
    Desktop: 6 columns. Tablet: 3 columns. Mobile: 2 columns, all six
    categories shown (no carousel/horizontal scroll). Keeps the existing
    collection data (image/title/link) and Theme Editor settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% assign overlay_base_1 = block.settings.overlay_color | color_modify: 'alpha', 0.72 %}
{% assign overlay_base_2 = block.settings.overlay_color | color_modify: 'alpha', 0.30 %}
{% assign overlay_base_3 = block.settings.overlay_color | color_modify: 'alpha', 0 %}
{% assign overlay_hover_1 = block.settings.border_hover_color | color_modify: 'alpha', 0.30 %}
{% assign overlay_hover_2 = block.settings.border_hover_color | color_modify: 'alpha', 0 %}

{% style %}
  .ai-jewellery-categories-{{ ai_gen_id }} {
    background: var(--bhima-color-page, #FFFDF9);
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-jewellery-categories__heading-wrapper-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-jewellery-categories__heading-{{ ai_gen_id }} {
    font-family: var(--font-family-primary);
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    letter-spacing: 0.06em;
    line-height: 1.3;
    margin: 0;
    padding-bottom: {{ block.settings.heading_padding_bottom }}px;
    text-transform: uppercase;
  }

  {% if block.settings.show_divider %}
    .ai-jewellery-categories__heading-{{ ai_gen_id }}::after {
      content: '';
      display: block;
      width: min({{ block.settings.divider_width }}px, 46px);
      height: min({{ block.settings.divider_height }}px, 1px);
      background-color: {{ block.settings.divider_color }};
      margin-top: {{ block.settings.divider_spacing }}px;
      {% if block.settings.heading_alignment == 'center' %}
        margin-left: auto;
        margin-right: auto;
      {% elsif block.settings.heading_alignment == 'right' %}
        margin-left: auto;
      {% endif %}
    }
  {% endif %}

  /* -------- grid -------- */
  .ai-jewellery-categories__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-jewellery-categories__item-{{ ai_gen_id }} {
    min-width: 0;
  }

  .ai-jewellery-categories__link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
  }

  /* -------- square editorial tile -------- */
  .ai-jewellery-categories__tile-{{ ai_gen_id }} {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.corner_radius }}px;
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    background-color: {{ block.settings.overlay_color }};
    transition: border-color 300ms ease;
  }

  .ai-jewellery-categories__image-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    transition: transform 300ms ease;
  }

  .ai-jewellery-categories__image-wrapper--empty-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    background-color: {{ block.settings.overlay_color }};
    opacity: 0.06;
  }

  /* readability gradient: always on, warm & dark toward the bottom */
  .ai-jewellery-categories__overlay-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top,
      {{ overlay_base_1 }} 0%,
      {{ overlay_base_2 }} 38%,
      {{ overlay_base_3 }} 68%
    );
  }

  /* subtle warm gold tint, fades in on hover only */
  .ai-jewellery-categories__tint-{{ ai_gen_id }} {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(to top,
      {{ overlay_hover_1 }} 0%,
      {{ overlay_hover_2 }} 55%
    );
    transition: opacity 300ms ease;
  }

  .ai-jewellery-categories__content-{{ ai_gen_id }} {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(14px, 3vw, 22px) 10px;
    transform: translateY(0);
    transition: transform 300ms ease;
  }

  .ai-jewellery-categories-{{ ai_gen_id }} .ai-jewellery-categories__item-{{ ai_gen_id }} .ai-jewellery-categories__title-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.category_title_color }};
    font-size: {{ block.settings.category_title_size }}px;
    font-weight: {{ block.settings.category_title_weight }};
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .ai-jewellery-categories__explore-{{ ai_gen_id }} {
    display: block;
    max-height: 0;
    margin-top: 0;
    overflow: hidden;
    opacity: 0;
    color: {{ block.settings.category_title_hover_color }};
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: opacity 280ms ease, max-height 280ms ease, margin-top 280ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .ai-jewellery-categories__link-{{ ai_gen_id }}:hover .ai-jewellery-categories__tile-{{ ai_gen_id }},
    .ai-jewellery-categories__link-{{ ai_gen_id }}:focus-visible .ai-jewellery-categories__tile-{{ ai_gen_id }} {
      border-color: {{ block.settings.border_hover_color }};
    }

    .ai-jewellery-categories__link-{{ ai_gen_id }}:hover .ai-jewellery-categories__image-{{ ai_gen_id }},
    .ai-jewellery-categories__link-{{ ai_gen_id }}:focus-visible .ai-jewellery-categories__image-{{ ai_gen_id }} {
      transform: scale(1.03);
    }

    .ai-jewellery-categories__link-{{ ai_gen_id }}:hover .ai-jewellery-categories__tint-{{ ai_gen_id }},
    .ai-jewellery-categories__link-{{ ai_gen_id }}:focus-visible .ai-jewellery-categories__tint-{{ ai_gen_id }} {
      opacity: 1;
    }

    .ai-jewellery-categories__link-{{ ai_gen_id }}:hover .ai-jewellery-categories__content-{{ ai_gen_id }},
    .ai-jewellery-categories__link-{{ ai_gen_id }}:focus-visible .ai-jewellery-categories__content-{{ ai_gen_id }} {
      transform: translateY(-4px);
    }

    .ai-jewellery-categories__link-{{ ai_gen_id }}:hover .ai-jewellery-categories__explore-{{ ai_gen_id }},
    .ai-jewellery-categories__link-{{ ai_gen_id }}:focus-visible .ai-jewellery-categories__explore-{{ ai_gen_id }} {
      opacity: 1;
      max-height: 20px;
      margin-top: 6px;
    }
  }

  .ai-jewellery-categories__link-{{ ai_gen_id }}:focus-visible .ai-jewellery-categories__tile-{{ ai_gen_id }} {
    outline: 1px solid {{ block.settings.border_hover_color }};
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-jewellery-categories__image-{{ ai_gen_id }},
    .ai-jewellery-categories__tint-{{ ai_gen_id }},
    .ai-jewellery-categories__content-{{ ai_gen_id }},
    .ai-jewellery-categories__explore-{{ ai_gen_id }},
    .ai-jewellery-categories__tile-{{ ai_gen_id }} {
      transition: none;
    }
  }

  /* -------- tablet -------- */
  @media screen and (max-width: 989px) {
    .ai-jewellery-categories__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }

    .ai-jewellery-categories__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, minmax(0, 1fr));
    }
  }

  /* -------- mobile: full 2-column grid, no carousel -------- */
  @media screen and (max-width: 749px) {
    .ai-jewellery-categories-{{ ai_gen_id }} {
      padding-top: {{ block.settings.section_padding_top | times: 0.6 | round }}px;
      padding-bottom: {{ block.settings.section_padding_bottom | times: 0.6 | round }}px;
    }

    .ai-jewellery-categories__heading-wrapper-{{ ai_gen_id }} {
      margin-bottom: 20px;
    }

    .ai-jewellery-categories__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.75 }}px;
    }

    .ai-jewellery-categories__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ block.settings.mobile_grid_gap }}px;
    }

    .ai-jewellery-categories__content-{{ ai_gen_id }} {
      padding: 12px 8px;
    }

    .ai-jewellery-categories-{{ ai_gen_id }} .ai-jewellery-categories__item-{{ ai_gen_id }} .ai-jewellery-categories__title-{{ ai_gen_id }} {
      font-size: 12.5px;
      letter-spacing: 0.05em;
    }

    .ai-jewellery-categories__explore-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<div class="ai-jewellery-categories-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="container">
    {% if block.settings.heading != blank %}
      <div class="ai-jewellery-categories__heading-wrapper-{{ ai_gen_id }}">
        <h2 class="ai-jewellery-categories__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      </div>
    {% endif %}

    <div class="ai-jewellery-categories__grid-{{ ai_gen_id }}" role="list">
      {% for i in (1..6) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
          assign category_image = collection.image | default: collection.featured_image
        %}

        {% if collection != blank %}
          <div class="ai-jewellery-categories__item-{{ ai_gen_id }}" role="listitem">
            <a href="{{ collection.url }}" class="ai-jewellery-categories__link-{{ ai_gen_id }}">
              <div class="ai-jewellery-categories__tile-{{ ai_gen_id }}">
                {% if category_image != blank %}
                  <img
                    src="{{ category_image | image_url: width: 700 }}"
                    srcset="{{ category_image | image_url: width: 400 }} 400w, {{ category_image | image_url: width: 700 }} 700w, {{ category_image | image_url: width: 1000 }} 1000w"
                    sizes="(max-width: 749px) 45vw, (max-width: 989px) 30vw, 16vw"
                    alt="{{ collection.title | escape }}"
                    class="ai-jewellery-categories__image-{{ ai_gen_id }}"
                    loading="lazy"
                    width="700"
                    height="700"
                  >
                {% else %}
                  <div class="ai-jewellery-categories__image-wrapper--empty-{{ ai_gen_id }}" aria-hidden="true"></div>
                {% endif %}
                <div class="ai-jewellery-categories__overlay-{{ ai_gen_id }}" aria-hidden="true"></div>
                <div class="ai-jewellery-categories__tint-{{ ai_gen_id }}" aria-hidden="true"></div>
                <div class="ai-jewellery-categories__content-{{ ai_gen_id }}">
                  <h3 class="ai-jewellery-categories__title-{{ ai_gen_id }}">
                    {{ collection.title }}
                  </h3>
                  <span class="ai-jewellery-categories__explore-{{ ai_gen_id }}">Explore &rarr;</span>
                </div>
              </div>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Jewellery categories",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 28
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "600"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1c1c1c"
    },
    {
      "type": "range",
      "id": "heading_padding_bottom",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Heading bottom padding",
      "default": 10
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 20,
      "max": 80,
      "step": 5,
      "unit": "px",
      "label": "Spacing below heading",
      "default": 40
    },
    {
      "type": "header",
      "content": "Divider"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": true
    },
    {
      "type": "range",
      "id": "divider_width",
      "min": 30,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Divider width",
      "default": 60
    },
    {
      "type": "range",
      "id": "divider_height",
      "min": 1,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Divider height",
      "default": 2
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#df9a7c"
    },
    {
      "type": "range",
      "id": "divider_spacing",
      "min": 5,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Divider spacing",
      "default": 10
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "6"
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Columns on tablet",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "2",
      "info": "All 6 categories always show, no carousel"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between items (desktop/tablet)",
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_grid_gap",
      "min": 8,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Gap between items (mobile)",
      "default": 12
    },
    {
      "type": "header",
      "content": "Category tile"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 6,
      "max": 12,
      "step": 2,
      "unit": "px",
      "label": "Tile corner radius",
      "default": 8
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "label": "Border width",
      "default": 1
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#E6D8C7"
    },
    {
      "type": "color",
      "id": "border_hover_color",
      "label": "Border hover color (gold)",
      "default": "#B77A18"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Gradient overlay color",
