{% doc %}
  @prompt
    Adjust the Jewellery category boxes and heading styling.
    
    1. Heading Requirements
    
    Add a section heading above the category boxes.
    
    Heading should have:
    
    Proper top & bottom spacing.
    
    Adjustable font size (e.g., 22–28px on desktop, slightly smaller on mobile).
    
    Center alignment or left alignment (choose based on theme).
    
    Optional: add a light underline or divider for visual separation.
    
    2. Category Boxes Requirements
    Corner Radius
    
    Add rounded corners (10–16px).
    
    Desktop Layout
    
    Display 6 category boxes in one row.
    
    Mobile Layout
    
    Display 3 columns × 2 rows (total 6 boxes visible).
    
    Ensure spacing is equal and auto-wrapped.
    
    Padding / Spacing
    
    Add inner padding so content doesn’t touch edges.
    
    Add outer spacing/gap between boxes.
    
    3. Output Needed
    
    Provide CSS (and Liquid structure if needed) that:
    
    Adds or styles the heading.
    
    Makes the category grid responsive.
    
    Applies rounded corners.
    
    Adds padding and spacing.
    
    Works on any theme (Dawn preferred, but flexible).
    
    Selector Notes:
    
    Target the category cards or grid using classes such as:
    
    .collection-list
    
    .collection-card
    
    .collection-grid
    (Use whichever matches theme.)
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-jewellery-categories-{{ ai_gen_id }} {
    background: var(--bhima-color-page, #FFFDF9);
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    overflow: hidden;
  }

  .ai-jewellery-categories__heading-wrapper-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-jewellery-categories__heading-{{ ai_gen_id }} {
    font-family: var(--font-family-primary);
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    letter-spacing: 0.06em;
    line-height: 1.3;
    margin: 0;
    padding-bottom: {{ block.settings.heading_padding_bottom }}px;
    text-transform: uppercase;
  }

  {% if block.settings.show_divider %}
    .ai-jewellery-categories__heading-{{ ai_gen_id }}::after {
      content: '';
      display: block;
      width: min({{ block.settings.divider_width }}px, 46px);
      height: min({{ block.settings.divider_height }}px, 1px);
      background-color: {{ block.settings.divider_color }};
      margin-top: {{ block.settings.divider_spacing }}px;
      {% if block.settings.heading_alignment == 'center' %}
        margin-left: auto;
        margin-right: auto;
      {% elsif block.settings.heading_alignment == 'right' %}
        margin-left: auto;
      {% endif %}
    }
  {% endif %}

  .ai-jewellery-categories__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    column-gap: clamp(28px, 3vw, 48px);
    row-gap: 24px;
    width: 100%;
  }

  .ai-jewellery-categories__item-{{ ai_gen_id }} {
    min-width: 0;
    text-align: center;
  }

  .ai-jewellery-categories__link-{{ ai_gen_id }} {
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    align-items: center;
    color: {{ block.settings.category_title_color }};
    text-decoration: none;
  }

  .ai-jewellery-categories__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    isolation: isolate;
    width: clamp(120px, 9.5vw, 145px);
    max-width: 100%;
    margin-inline: auto;
    aspect-ratio: 1;
    background-color: {{ block.settings.card_background }};
    border: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-radius: 50%;
    overflow: hidden;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .ai-jewellery-categories__image-wrapper-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    z-index: 2;
    top: -30%;
    bottom: -30%;
    left: -70%;
    width: 42%;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      112deg,
      transparent 0%,
      rgba(197, 138, 42, 0.04) 34%,
      rgba(255, 248, 232, 0.28) 48%,
      rgba(197, 138, 42, 0.14) 56%,
      transparent 72%
    );
    transform: translateX(0) skewX(-12deg);
  }

  .ai-jewellery-categories__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    transition: transform 0.35s ease;
  }

  .ai-jewellery-categories__image-wrapper--empty-{{ ai_gen_id }} {
    background-color: transparent;
  }

  .ai-jewellery-categories__title-{{ ai_gen_id }} {
    display: flex;
    min-height: 2.8em;
    align-items: flex-start;
    justify-content: center;
    margin: {{ block.settings.image_spacing }}px 0 0;
    color: {{ block.settings.category_title_color }};
    font-size: {{ block.settings.category_title_size }}px;
    font-weight: {{ block.settings.category_title_weight }};
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-align: center;
    transition: color 0.25s ease;
  }

  .ai-jewellery-categories__link-{{ ai_gen_id }}:hover .ai-jewellery-categories__image-wrapper-{{ ai_gen_id }},
  .ai-jewellery-categories__link-{{ ai_gen_id }}:focus-visible .ai-jewellery-categories__image-wrapper-{{ ai_gen_id }} {
    border-color: {{ block.settings.border_hover_color }};
    transform: translateY(-{{ block.settings.hover_lift | at_most: 3 }}px);
  }

  .ai-jewellery-categories__link-{{ ai_gen_id }}:hover .ai-jewellery-categories__image-{{ ai_gen_id }},
  .ai-jewellery-categories__link-{{ ai_gen_id }}:focus-visible .ai-jewellery-categories__image-{{ ai_gen_id }} {
    transform: scale(1.035);
  }

  .ai-jewellery-categories__link-{{ ai_gen_id }}:hover .ai-jewellery-categories__title-{{ ai_gen_id }},
  .ai-jewellery-categories__link-{{ ai_gen_id }}:focus-visible .ai-jewellery-categories__title-{{ ai_gen_id }} {
    color: {{ block.settings.category_title_hover_color }};
  }

  .ai-jewellery-categories__link-{{ ai_gen_id }}:focus-visible {
    outline: 1px solid {{ block.settings.border_hover_color }};
    outline-offset: 5px;
  }

  @keyframes ai-jewellery-category-shine-{{ ai_gen_id }} {
    0% {
      opacity: 0;
      transform: translateX(0) skewX(-12deg);
    }
    18% {
      opacity: 0.72;
    }
    100% {
      opacity: 0;
      transform: translateX(390%) skewX(-12deg);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .ai-jewellery-categories__link-{{ ai_gen_id }}:hover .ai-jewellery-categories__image-wrapper-{{ ai_gen_id }},
    .ai-jewellery-categories__link-{{ ai_gen_id }}:focus-visible .ai-jewellery-categories__image-wrapper-{{ ai_gen_id }} {
      box-shadow: inset 0 0 0 1px rgba(197, 138, 42, 0.38);
    }

    .ai-jewellery-categories__link-{{ ai_gen_id }}:hover .ai-jewellery-categories__image-wrapper-{{ ai_gen_id }}::after,
    .ai-jewellery-categories__link-{{ ai_gen_id }}:focus-visible .ai-jewellery-categories__image-wrapper-{{ ai_gen_id }}::after {
      animation: ai-jewellery-category-shine-{{ ai_gen_id }} 900ms ease-out 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-jewellery-categories__image-wrapper-{{ ai_gen_id }}::after {
      animation: none !important;
    }
  }

  @media screen and (max-width: 989px) {
    .ai-jewellery-categories__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }

    .ai-jewellery-categories__grid-{{ ai_gen_id }} {
      column-gap: 16px;
      row-gap: 24px;
    }

    .ai-jewellery-categories__image-wrapper-{{ ai_gen_id }} {
      width: clamp(95px, 12vw, 120px);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-jewellery-categories-{{ ai_gen_id }} {
      padding-top: 4px;
      padding-bottom: 8px;
    }

    .ai-jewellery-categories__heading-wrapper-{{ ai_gen_id }} {
      margin-bottom: 16px;
    }

    .ai-jewellery-categories__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.75 }}px;
    }

    .ai-jewellery-categories__grid-{{ ai_gen_id }} {
      display: flex;
      justify-content: flex-start;
      gap: 24px;
      margin-right: calc(var(--bhima-home-gutter, 16px) * -1);
      margin-left: calc(var(--bhima-home-gutter, 16px) * -1);
      padding: 2px var(--bhima-home-gutter, 16px) 8px;
      overflow-x: auto;
      overflow-y: visible;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
    }

    .ai-jewellery-categories__grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-jewellery-categories__item-{{ ai_gen_id }} {
      flex: 0 0 clamp(82px, 22vw, 105px);
      scroll-snap-align: start;
    }
  }
{% endstyle %}

<div class="ai-jewellery-categories-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="container">
    {% if block.settings.heading != blank %}
      <div class="ai-jewellery-categories__heading-wrapper-{{ ai_gen_id }}">
        <h2 class="ai-jewellery-categories__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      </div>
    {% endif %}

    <div class="ai-jewellery-categories__grid-{{ ai_gen_id }}" role="list">
      {% for i in (1..6) %}
        {% liquid
          assign collection_key = 'collection_' | append: i
          assign collection = block.settings[collection_key]
          assign category_image = collection.image | default: collection.featured_image
        %}

        {% if collection != blank %}
          <div class="ai-jewellery-categories__item-{{ ai_gen_id }}" role="listitem">
            <a href="{{ collection.url }}" class="ai-jewellery-categories__link-{{ ai_gen_id }}">
              {% if category_image != blank %}
              <div class="ai-jewellery-categories__image-wrapper-{{ ai_gen_id }}">
                <img
                  src="{{ category_image | image_url: width: 600 }}"
                  alt="{{ collection.title | escape }}"
                  class="ai-jewellery-categories__image-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              </div>
              {% else %}
                <div class="ai-jewellery-categories__image-wrapper-{{ ai_gen_id }} ai-jewellery-categories__image-wrapper--empty-{{ ai_gen_id }}" aria-hidden="true"></div>
              {% endif %}
              <h3 class="ai-jewellery-categories__title-{{ ai_gen_id }}">
                {{ collection.title }}
              </h3>
            </a>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</div>

