{%- comment -%}
  BHIMA — Experience Bhima / Shop Tour.

  The section is intentionally block-driven so the merchant can manage the
  carousel and showroom categories from the Theme Editor. The older hidden
  accordion section remains in the homepage template as a content backup.
{%- endcomment -%}

{%- liquid
  assign sst = section.settings
  assign carousel_blocks = section.blocks | where: 'type', 'carousel_image'
  assign category_blocks = section.blocks | where: 'type', 'showroom_category'
-%}

{%- if sst.enable_section -%}
  {{ 'bhima-experience.css' | asset_url | stylesheet_tag }}

  <section
    id="ExperienceBhima-{{ section.id }}"
    class="bhima-experience"
    aria-labelledby="ExperienceBhimaHeading-{{ section.id }}"
  >
    <div class="bhima-experience__inner">
      <div class="bhima-experience__layout">
        <div
          class="bhima-experience__media"
          style="--exp-media-pos: {{ sst.image_position }};"
          {% if carousel_blocks.size > 1 %}
            data-carousel
            data-autoplay="{{ sst.autoplay_speed | times: 1000 }}"
            data-autoplay-enabled="{{ sst.autoplay }}"
          {% endif %}
        >
          <div class="bhima-experience__slides" aria-live="polite">
            {%- if carousel_blocks.size > 0 -%}
              {%- for block in carousel_blocks -%}
                {%- liquid
                  assign slide_image = block.settings.image
                  assign slide_alt = slide_image.alt | default: block.settings.alt | default: 'Bhima showroom'
                  assign slide_loading = 'lazy'
                  if forloop.first
                    assign slide_loading = 'eager'
                  endif
                -%}
                <div
                  class="bhima-experience__slide{% if forloop.first %} is-active{% endif %}"
                  data-slide-index="{{ forloop.index0 }}"
                  {{ block.shopify_attributes }}
                >
                  {%- if slide_image != blank -%}
                    {{
                      slide_image
                      | image_url: width: 1800
                      | image_tag:
                        loading: slide_loading,
                        widths: '480, 700, 960, 1280, 1600, 1800',
                        sizes: '(min-width: 990px) 58vw, 100vw',
                        class: 'bhima-experience__slide-image',
                        alt: slide_alt
                    }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'bhima-experience__slide-image placeholder-svg' }}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- else -%}
              <div class="bhima-experience__slide is-active">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'bhima-experience__slide-image placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>

          {%- if carousel_blocks.size > 1 -%}
            <button type="button" class="bhima-experience__arrow bhima-experience__arrow--prev" aria-label="Previous showroom image">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 5-7 7 7 7"></path></svg>
            </button>
            <button type="button" class="bhima-experience__arrow bhima-experience__arrow--next" aria-label="Next showroom image">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 5 7 7-7 7"></path></svg>
            </button>
            <div class="bhima-experience__dots" role="tablist" aria-label="Showroom images">
              {%- for block in carousel_blocks -%}
                <button
                  type="button"
                  class="bhima-experience__dot{% if forloop.first %} is-active{% endif %}"
                  role="tab"
                  aria-label="Show showroom image {{ forloop.index }}"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-controls="ExperienceBhima-{{ section.id }}"
                  data-slide-to="{{ forloop.index0 }}"
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

        <div class="bhima-experience__content">
          <div class="bhima-experience__intro">
            {%- if sst.eyebrow != blank -%}
              <p class="bhima-experience__eyebrow">{{ sst.eyebrow | escape }}</p>
            {%- endif -%}
            <h2 id="ExperienceBhimaHeading-{{ section.id }}" class="bhima-experience__heading">
              {{ sst.heading | escape | newline_to_br }}
            </h2>
            {%- if sst.subheading != blank -%}
              <div class="bhima-experience__subheading">{{ sst.subheading }}</div>
            {%- endif -%}
            {%- if sst.intro != blank -%}
              <div class="bhima-experience__description">{{ sst.intro }}</div>
            {%- endif -%}
          </div>

          {%- if category_blocks.size > 0 -%}
            <div class="bhima-experience__categories" data-accordion>
              {%- for block in category_blocks -%}
                {%- assign category = block.settings -%}
                <div class="bhima-experience__category{% if forloop.first %} is-open{% endif %}" data-accordion-item data-slide-target="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                  <h3 class="bhima-experience__category-heading">
                    <button
                      type="button"
                      class="bhima-experience__category-trigger"
                      aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}"
                      aria-controls="ExperienceCategory-{{ section.id }}-{{ block.id }}"
                    >
                      <span>{{ category.title | escape }}</span>
                      <span class="bhima-experience__category-icon" aria-hidden="true"></span>
                    </button>
                  </h3>
                  <div id="ExperienceCategory-{{ section.id }}-{{ block.id }}" class="bhima-experience__category-panel"{% unless forloop.first %} hidden{% endunless %}>
                    {%- if category.description != blank -%}
                      <div class="bhima-experience__category-description">{{ category.description }}</div>
                    {%- endif -%}
                    {%- if category.link != blank -%}
                      <a class="bhima-experience__category-link" href="{{ category.link }}">
                        {{ category.link_label | default: 'Explore' | escape }} <span aria-hidden="true">→</span>
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}

        </div>
      </div>
    </div>
  </section>

  {%- if carousel_blocks.size > 1 or category_blocks.size > 0 -%}
    <script>
      (function () {
        var root = document.getElementById('ExperienceBhima-{{ section.id }}');
        if (!root || root.dataset.initialized === 'true') return;
        root.dataset.initialized = 'true';
        var setSlide = null;

        var media = root.querySelector('[data-carousel]');
        if (media) {
          var slides = Array.prototype.slice.call(media.querySelectorAll('.bhima-experience__slide'));
          var dots = Array.prototype.slice.call(media.querySelectorAll('.bhima-experience__dot'));
          var prev = media.querySelector('.bhima-experience__arrow--prev');
          var next = media.querySelector('.bhima-experience__arrow--next');
          var index = 0;
          var timer = null;
          var delay = parseInt(media.getAttribute('data-autoplay'), 10) || 5000;
          var autoplay = media.getAttribute('data-autoplay-enabled') === 'true';
          var reducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var touchStartX = 0;
          var touchStartY = 0;

          setSlide = function (nextIndex) {
            index = (nextIndex + slides.length) % slides.length;
            slides.forEach(function (slide, i) { slide.classList.toggle('is-active', i === index); });
            dots.forEach(function (dot, i) {
              dot.classList.toggle('is-active', i === index);
              dot.setAttribute('aria-selected', i === index ? 'true' : 'false');
            });
          };

          function stop() {
            if (timer) window.clearInterval(timer);
            timer = null;
          }

          function start() {
            stop();
            if (autoplay && !reducedMotion) timer = window.setInterval(function () { setSlide(index + 1); }, delay);
          }

          function interact(nextIndex) {
            setSlide(nextIndex);
            start();
          }

          if (prev) prev.addEventListener('click', function () { interact(index - 1); });
          if (next) next.addEventListener('click', function () { interact(index + 1); });
          dots.forEach(function (dot) {
            dot.addEventListener('click', function () { interact(parseInt(dot.getAttribute('data-slide-to'), 10)); });
          });
          media.addEventListener('mouseenter', stop);
          media.addEventListener('mouseleave', start);
          media.addEventListener('focusin', stop);
          media.addEventListener('focusout', function (event) { if (!media.contains(event.relatedTarget)) start(); });
          media.addEventListener('touchstart', function (event) {
            touchStartX = event.changedTouches[0].screenX;
            touchStartY = event.changedTouches[0].screenY;
            stop();
          }, { passive: true });
          media.addEventListener('touchend', function (event) {
            var deltaX = event.changedTouches[0].screenX - touchStartX;
            var deltaY = event.changedTouches[0].screenY - touchStartY;
            if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) interact(index + (deltaX < 0 ? 1 : -1));
            else start();
          }, { passive: true });
          document.addEventListener('visibilitychange', function () { document.hidden ? stop() : start(); });
          start();
        }

        var accordion = root.querySelector('[data-accordion]');
        if (accordion) {
          accordion.querySelectorAll('[data-accordion-item]').forEach(function (item) {
            var trigger = item.querySelector('.bhima-experience__category-trigger');
            var panel = item.querySelector('.bhima-experience__category-panel');
            if (!trigger || !panel) return;
            trigger.addEventListener('click', function () {
              var shouldOpen = trigger.getAttribute('aria-expanded') !== 'true';
              var targetIndex = parseInt(item.getAttribute('data-slide-target'), 10);
              accordion.querySelectorAll('[data-accordion-item]').forEach(function (other) {
                var otherTrigger = other.querySelector('.bhima-experience__category-trigger');
                var otherPanel = other.querySelector('.bhima-experience__category-panel');
                other.classList.remove('is-open');
                otherTrigger.setAttribute('aria-expanded', 'false');
                otherPanel.hidden = true;
              });
              if (shouldOpen) {
                if (setSlide && !isNaN(targetIndex)) setSlide(targetIndex);
                item.classList.add('is-open');
                trigger.setAttribute('aria-expanded', 'true');
                panel.hidden = false;
              }
            });
          });
        }
      })();
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Experience Bhima",
  "tag": "section",
  "class": "section-bhima-experience",
  "max_blocks": 20,
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_section",
      "label": "Show section",
      "default": true
    },
    {
      "type": "header",
      "content": "Showroom image carousel"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "default": "center center",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay carousel",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Carousel speed",
      "min": 3,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "header",
      "content": "Experience content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "EXPERIENCE BHIMA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP TOUR — BHIMA JEWELLERY"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Intro statement",
      "default": "<p>Experience elegance. Discover craftsmanship. Celebrate 101 years of trust.</p>"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Description",
      "default": "<p>Step into the world of <strong>Bhima Jewellery</strong>, where tradition meets modern luxury. Every Bhima showroom is thoughtfully designed to offer a seamless, warm, and memorable jewellery-buying experience. Explore exclusive sections curated for every category — from antique treasures to contemporary diamond brilliance.</p>"
    },
  ],
  "blocks": [
    {
      "type": "carousel_image",
      "name": "Carousel image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text", "default": "Bhima showroom" }
      ]
    },
    {
      "type": "showroom_category",
      "name": "Showroom category",
      "settings": [
        { "type": "text", "id": "title", "label": "Category name", "default": "Showroom category" },
        { "type": "richtext", "id": "description", "label": "Description" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Experience Bhima",
      "blocks": [
        { "type": "carousel_image" },
        { "type": "showroom_category" },
        { "type": "showroom_category" },
        { "type": "showroom_category" },
        { "type": "showroom_category" }
      ]
    }
  ]
}
{% endschema %}
