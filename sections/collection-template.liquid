{% render 'nov-breadcrumb', class_br: 'breadcrumb_collection collection-shell', force: true, show_collection_count: true, products_per_page: sst.products_per_page %}
{% if sst.show_list_collection %}
  <div class="container mb-100 mb-lg-50">
    <div class="block-collection-list" data-section-id="{{ section.id }}" data-section-type="nov-slick">
      <div class="nov-slick-carousel row spacing-{{ sst.spacing }} arrow_on_light"
        data-autoplay="false" 
        data-autoplayTimeout="6000" 
        data-loop="false"
        data-dots="false"
        data-nav="{{ sst.show_nav }}"
        data-row="1"
        data-items_xxl="{{ sst.xxl }}"
        data-items_xl="{{ sst.xl }}"
        data-items_lg="{{ sst.lg }}"
        data-items_md="{{ sst.md }}"
        data-items_sm="{{ sst.sm }}"
        data-items_xs="{{ sst.xs }}">
        {% for block in section.blocks %}
          {%- assign collec = collections[block.settings.collection] -%}
          <div class="sp-item text-center {%- render 'number-to-col' -%}">
            <a href="{{ collec.url }}" class="item d-block">
              {% if block.settings.image != blank %}
                {% render 'nov-aspect-image', image: block.settings.image, aspect: '11' %}
              {% else %}
                {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </a>
            <a href="{{ collec.url }}" class="mt-30 d-inline-block {{ sst.font_size_title }}">
              {% if collec.title != blank %}{{ collec.title }}{% else %}Lorem ipsum{% endif %}
            </a>
            <div class="count">{{ 'collections.general.products' | t: count: collec.products_count }}</div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
{% endif %}
<div id="main-collection-filters" class="collection-{{ viewtype }}" data-id="{{ section.id }}">
  {% if viewtype != 'full_width' %}
    <div class="container">
  {% endif %}
    <div class="collection-top">
      <div class="filter_button collection-heading font-800 f_pr text-uppercase mb-20 nov_btn_act{% if viewtype == 'canvasleft' or viewtype == 'canvastop' or viewtype == 'canvasbottom' %} d-inline-block{% endif %}{% if viewtype == 'withoutsidebar' %} d-none{% endif %}" data-overlay="true" data-toggle="FilterSidebar" role="button" tabindex="0">
        <i class="zmdi zmdi-tune"></i>
        <span class="d-md-inline-block">{{ 'collections.filters.button' | t }}</span>
        <i class="zmdi zmdi-chevron-down"></i>
      </div>
      <div class="collection-toolbar__active-filters">
        <div class="active-facets facets-remove-all d-flex flex-wrap align-items-center">
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <facet-remove class="btn--clear--item{% if forloop.first == true %} first{% endif %}">
                <a href="{{ value.url_to_remove }}" class="active-facets__button position-relative d-flex align-items-center">
                  <span><span class="filter__label">{{ filter.label | escape }}:</span> <strong>{{ value.label | escape }}</strong></span>
                  <i class="zmdi zmdi-close"></i>
                </a>
              </facet-remove>
            {%- endfor -%}
            {% if filter.type == "price_range" %}
              {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                <facet-remove class="btn--clear--item">
                  <a href="{{ filter.url_to_remove }}" class="active-facets__button reset_price position-relative d-flex align-items-center">
                    <span>
                      <span class="filter__label">{{ filter.label | escape }}:</span>
                      <strong>
                        <span class="min_price">{%- if filter.min_value.value -%}{{ filter.min_value.value | money }}{%- else -%}{{ 0 | money }}{%- endif -%}</span>-<span class="max_price">{%- if filter.max_value.value -%}{{ filter.max_value.value | money }}{%- else -%}{{ filter.range_max | money }}{%- endif -%}</span>
                      </strong>
                    </span>
                    <i class="zmdi zmdi-close"></i>
                  </a>
                </facet-remove>
              {%- endif -%}
            {% endif %}
          {%- endfor -%}
          <facet-remove class="btn--clear--all">
            <a href="{{ collection.url }}" class="active-facets__button">
              <span>{{ 'collections.filters.clear_all' | t }}</span>
            </a>
          </facet-remove>
        </div>
      </div>
      <div class="sidebar-filter{% if viewtype == 'rightsidebar' %} order-0 order-md-2{% endif %} nov_item_act" data-act="FilterSidebar">
        <div class="sidebar-filter__mobile-header">
          <span>{{ 'collections.sidebar.heading_filter' | t }}</span>
          <button type="button" class="sidebar-filter__mobile-close nov_btn_close" data-overlay data-close="FilterSidebar" aria-label="{{ 'general.accessibility.close_modal' | t | escape }}">
            <i class="zmdi zmdi-close" aria-hidden="true"></i>
          </button>
        </div>
        {% if viewtype == 'canvasleft' or viewtype == 'canvastop' or viewtype == 'canvasbottom' %}
          <div class="sidebar-filter__btn-close nov_btn_close" data-overlay data-close="FilterSidebar">
            <i class="zmdi zmdi-chevron-left"></i>
            <i class="zmdi zmdi-chevron-left"></i>
          </div>
        {% endif %}
        <div class="sidebar-filter__content">
          {% if sst.category != blank %}
            {% unless viewtype == 'topsidebar' or viewtype == 'canvastop' or viewtype == 'canvasbottom' %}
              <div class="collection-heading collection-category__heading font-800 font_primary f_df text-uppercase d-none d-lg-flex align-items-center mb-25">
                <i class="zmdi zmdi-view-headline"></i>{{ 'collections.sidebar.heading_collection' | t }}
              </div>
              {%- assign category = sst.category -%}
              {%- assign catelimit = sst.show_more -%}
              <nav class="collection__category collection-category__list mb-35" aria-label="{{ 'collections.sidebar.heading_collection' | t | escape }}">
                {% for link in linklists[category].links %}
                  <div class="collection__category-item{% if link.current or link.active %} is-active{% endif %}{% if forloop.index > catelimit %} hide{% endif %}">
                    <a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
                  </div>
                {% endfor %}
                {% if linklists[category].links.size > catelimit %}
                  <div class="collection__category-item collection__category-seemore">
                    <a href="#" class="font-600">
                      <span class="seemore">{{ 'collections.general.see_more' | t }}</span>
                      <span class="seeless">{{ 'collections.general.see_less' | t }}</span>
                    </a>
                  </div>
                {% endif %}
              </nav>
            {% endunless %}
          {% endif %}
          {% unless viewtype == 'canvastop' or viewtype == 'canvasbottom' %}
            <div class="collection-heading heading_filter font-800 f_pr text-uppercase d-none d-lg-flex align-items-center pb-25 mb-25">
              <i class="zmdi zmdi-tune"></i>{{ 'collections.sidebar.heading_filter' | t }}
            </div>
          {% endunless %}
          {% render 'collection-filters', results: collection, viewtype: viewtype %}
        </div>
      </div>
      <div class="collection-filter__content">
        <div class="collection-toolbar d-flex align-items-center justify-content-between pt-10 pb-30">
          {% if sst.sort_enable %}
            <div class="collection-toolbar__sort position-relative" data-sortby-filter>
              <div class="collection-toolbar__sort-trigger nov-accordion__title d-flex align-items-center pointer position-relative" role="button" tabindex="0">
                <div class="dropdown-toggle__content position-relative">
                  {{ 'collections.sorting.title' | t }}&nbsp;
                  <span class="sort-by__label font-700"></span>&nbsp;
                  <i class="zmdi zmdi-chevron-down"></i>
                </div>
              </div>
              <div class="collection-toolbar__sort-menu nov-accordion__content position-absolute">
                {%- for option in collection.sort_options -%}
                  <div data-value="{{ option.value | escape }}" data-sortby-item><span></span>{{ option.name | escape }}</div>
                {%- endfor -%}
              </div>
            </div>
          {% endif %}
          <div class="collection-toolbar__views gridlist-toggle" role="group" aria-label="Collection view options">
            {% if viewtype != 'flash_deal' %}
              <a href="#" id="grid-4" title="Grid View 4" data-type="grid-4" class="{% if viewtype != 'flash_deal' %}active {% endif %}d-none d-lg-flex"><i class="zmdi zmdi-view-comfy"></i></a>
            {% endif %}
            <a href="#" id="grid-3" title="Grid View 3" data-type="grid-3" class="{% if viewtype == 'flash_deal' %}active{% endif %}"><i class="rbb-icon-view-grid-2"></i></a>
            <a href="#" id="grid-2" title="Grid View 2" data-type="grid-2"><i class="rbb-icon-view-grid-1"></i></a>
            {% if viewtype != 'flash_deal' %}
              <a href="#" id="list" title="List View" data-type="list"><i class="rbb-icon-view-list-1"></i></a>
            {% endif %}
          </div>
        </div>
        <div class="collection__product-content collection-template collection--product-{{ viewtype }}" {% if viewtype != 'flash_deal' %}data-grid="grid-4"{% else %}data-grid="grid-3"{% endif %}>
          <div id="CollectionProductContainer">
            {%- paginate collection.products by sst.products_per_page -%} 
            {%- if collection.products.size == 0 -%}
              <div id="product-grid" data-id="{{ section.id }}" class="text-center pt-60">
                <h2 class="mb-20">{{ 'collections.filters.empty' | t }}</h2>
                <h4>{{ 'collections.filters.use_fewer_filters_html' | t: link: collection.url }}</h4>
              </div>
            {%- else -%}
              <div id="product-grid" data-id="{{ section.id }}"{% if paginate.next %} data-next-url="{{ paginate.next.url }}"{% endif %} class="product-collection collection__grid-loadmore row grid--view-items spacing-md-15">
                {%- for product in collection.products -%}
                  <div class="product--item item col mb-md-15">
                    {% render 'product-grid-item-style-collection', product: product, section_id: section.id, viewtype: viewtype %}
                  </div>
                {%- endfor -%}
              </div>
              {% if sst.loadmore == true and sst.type_loadmore == 'scroll' and paginate.pages > 1 %}
                <div class="paging" style="text-align: center;">
                  {% render 'pagination-page' paginate: paginate %}
                </div>
              {% endif %}
              {% if sst.loadmore == true %}
                <div class="collection-loadmore__bottom text-center mt-30">
                  <div class="pagination__count collection-toolbar__count collection-toolbar__count--loadmore mb-15">{{ 'collections.general.product_count_html' | t: count: collection.products.size, total: collection.products_count }}</div>
                  <div class="pagination__bar position-relative mb-30" data-max="{{ collection.products_count }}">
                    <span class="progress position-absolute" style="width: {{ collection.products.size | times: 100 | divided_by: collection.products_count }}%"></span>
                  </div>
                  {% if sst.type_loadmore == 'btn' and paginate.pages > 1 %}
                    <div class="collection__btn-loadmore btn d-inline-flex align-items-center justify-content-center">
                      <span>{{ 'collections.loadmore.button' | t }}</span>
                      <div class="load"></div>
                    </div>
                  {% endif %}
                </div>
              {% endif %}
              {%- if paginate.pages > 1 and sst.loadmore == false -%}
                <div class="nov-pagination d-flex align-items-center">{% render 'pagination', paginate: paginate, anchor: '', class: '' %}</div>
              {%- endif -%}
            {%- endif -%}
            {%- endpaginate -%}
          </div>
        </div>
      </div>
    </div>
  {% if viewtype != 'full_width' %}
    </div>
  {% endif %}
  {% if sst.cb %}
    <div class="collection-bottom pt-100 pb-100 mt-100" style="background-color: {{ sst.bg_b }}">
      {% if viewtype != 'full_width' %}
        <div class="container">
      {% endif %}
      {% if sst.show_tags %}
        <div class="facets__tag">
          <div class="tag__label font-800 color-title text-uppercase d-flex align-items-center mb-25">
            <i class="zmdi zmdi-label"></i>
            <span class="facets__label--title">{{ 'collections.filters.filter_tags' | t }}</span>
          </div>
          <div class="facets__content">
            <ul class="product_tags list-unstyled">
              {% for tag in collection.tags %}
                <li>{{ tag | link_to_tag: tag }}</li>
              {% endfor %}
            </ul>
          </div>
        </div>
      {% endif %}
      {% if sst.show_desc and collection.description != blank %}
        <div class="collection__desc mt-60">
          <div class="collection__title-seo text-uppercase font-800 f_pr color-title">{{ page_title }}</div>
          <div class="collection__desc-content nov-toggle-contents mt-20 position-relative nov_item_act" data-act="DescContent">{{ collection.description }}</div>
          <div class="collection__desc-btn text-center font-600 text-uppercase mt-20 nov_btn_act" data-toggle="DescContent">
            <span class="see_more pointer c_df hover:c_pr">{{ 'collections.general.see_more' | t }}</span>
            <span class="see_less pointer c_df hover:c_pr">{{ 'collections.general.see_less' | t }}</span>
          </div>
        </div>
      {% endif %}
      {% if viewtype != 'full_width' %}
        </div>
      {% endif %}
    </div>
  {% endif %}
  <script src="{{ 'nov-collection-filters-product.js' | asset_url }}" defer></script>
</div>
{% schema %}
  {
