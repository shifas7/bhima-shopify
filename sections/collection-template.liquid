{%- assign sst = section.settings -%}
{%- liquid
  assign banner_img = blank
  if collection.metafields.custom.collection_banner.value != blank
    assign banner_img = collection.metafields.custom.collection_banner.value
  elsif sst.use_collection_image_fallback and collection.image != blank
    assign banner_img = collection.image
  else
    assign banner_img = sst.banner
  endif

  assign banner_mobile_img = blank
  if collection.metafields.custom.collection_banner_mobile.value != blank
    assign banner_mobile_img = collection.metafields.custom.collection_banner_mobile.value
  endif

  assign banner_link = blank
  if collection.metafields.custom.collection_banner_link.value != blank
    assign banner_link = collection.metafields.custom.collection_banner_link.value
  endif
-%}
{% if template == "collection.leftsidebar" %}
  {% assign viewtype = "leftsidebar" %}
{% elsif template == "collection.rightsidebar" %}
  {% assign viewtype = 'rightsidebar' %}
{% elsif template == "collection.topsidebar" %}
  {% assign viewtype = 'topsidebar' %}
{% elsif template == "collection.withoutsidebar" %}
  {% assign viewtype = 'withoutsidebar' %}
{% elsif template == "collection.canvasleft" %}
  {% assign viewtype = 'canvasleft' %}
{% elsif template == "collection.canvastop" %}
  {% assign viewtype = 'canvastop' %}
{% elsif template == "collection.canvasbottom" %}
  {% assign viewtype = 'canvasbottom' %}
{% elsif template == "collection.full_width" %}
  {% assign viewtype = 'full_width' %}
{% else %}
  {% if collection.handle == 'flash-deals' %}
    {% assign viewtype = 'flash_deal' %}
  {% elsif settings.type_sidebar == 'sidebar_left' %}
    {% assign viewtype = 'leftsidebar' %}
  {% elsif settings.type_sidebar == 'sidebar_right' %}
    {% assign viewtype = 'rightsidebar' %}
  {% elsif settings.type_sidebar == 'topsidebar' %}
    {% assign viewtype = 'topsidebar' %}
  {% elsif settings.type_sidebar == 'withoutsidebar' %}
  {% assign viewtype = 'withoutsidebar' %}
  {% elsif settings.type_sidebar == "canvasleft" %}
    {% assign viewtype = 'canvasleft' %}
  {% elsif settings.type_sidebar == "canvastop" %}
    {% assign viewtype = 'canvastop' %}
  {% elsif settings.type_sidebar == "canvasbottom" %}
  {% assign viewtype = 'canvasbottom' %}
  {% elsif settings.type_sidebar == 'full_width' %}
    {% assign viewtype = 'full_width' %}
  {% else %}
    {% assign viewtype = 'full_width' %}
  {% endif %}
{% endif %}
{{ 'css-collection_page.css' | asset_url | stylesheet_tag }}
{% style %}
  .template-collection .collection__desc-content:before {
    background: linear-gradient(to top,rgba({{ sst.bg_b | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }}, 90%),rgba({{ sst.bg_b | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }}, 10%));
  }
  {% if collection.image != blank %}
    #NovBreadcrumbs {
      background-image: url('{{ collection.image | image_url: width: 2560 }}');
    }
  {% elsif settings.breadcrumb_collection_image != blank %}
    #NovBreadcrumbs {
      background-image: url('{{ settings.breadcrumb_collection_image | image_url: width: 2560 }}');
    }
  {% endif %}
  {% if viewtype == 'full_width' %}
    #NovBreadcrumbs .container {
      max-width: 100%;
    }
    @media (min-width: 992px) {
      #NovBreadcrumbs .container {
        padding: 0 30px;
      }
    }
    @media (min-width: 1600px) {
      #NovBreadcrumbs .container {
        padding: 0 65px;
      }
    }
  {% endif %}
  .collection_banner {
    position: relative;
    overflow: hidden;
    margin-bottom: 30px;
    border-radius: 8px;
  }
  .collection_banner--full {
    border-radius: 0;
    margin-bottom: 40px;
  }
  .collection_banner a {
    display: block;
    width: 100%;
  }
  .collection_banner img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), filter 0.6s ease;
  }
  .collection_banner a:hover img {
    transform: scale(1.015);
    filter: brightness(0.95);
  }
  @media (max-width: 767px) {
    .collection_banner {
      margin-bottom: 20px;
      border-radius: 4px;
    }
    .collection_banner--full {
      border-radius: 0;
      margin-bottom: 25px;
    }
  }
  {% if sst.banner_height_mode == 'custom' %}
    .collection_banner .respone_image {
      padding-top: 0 !important;
      height: {{ sst.banner_height_desktop }}px !important;
    }
    .collection_banner .respone_image img {
      height: 100% !important;
      object-fit: cover;
      object-position: center;
    }
    @media (max-width: 767px) {
      .collection_banner .respone_image {
        height: {{ sst.banner_height_mobile }}px !important;
      }
    }
  {% endif %}

  /* Phase 1: collection shell and toolbar */
  #shopify-section-{{ section.id }} #NovBreadcrumbs.collection-shell {
    margin: 0;
    padding: 0;
    border: 0;
    background-color: transparent;
    background-image: none !important;
  }
  #shopify-section-{{ section.id }} #NovBreadcrumbs.collection-shell .container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 24px;
    padding-bottom: 22px;
  }
  #shopify-section-{{ section.id }} #NovBreadcrumbs.collection-shell .breadcrumb {
    order: 1;
    display: flex;
    align-items: center;
    min-height: 18px;
    margin: 0 0 12px;
    padding: 0;
    background: transparent;
    color: var(--color-text);
    font-size: 12px;
    line-height: 1.4;
  }
  #shopify-section-{{ section.id }} #NovBreadcrumbs.collection-shell .headingBreacrumb {
    order: 2;
    max-width: 100%;
    margin: 0 0 7px !important;
    color: var(--color-title);
    font-size: clamp(2.2rem, 2.2vw, 2.8rem);
    line-height: 1.15;
    overflow-wrap: anywhere;
  }
  #shopify-section-{{ section.id }} #NovBreadcrumbs.collection-shell .collection-shell__count {
    order: 3;
    margin: 0;
    color: var(--color-text);
    font-size: 12px;
    line-height: 1.4;
  }
  #shopify-section-{{ section.id }} #NovBreadcrumbs.collection-shell .collection-shell__count span {
    color: var(--color-title);
    font-weight: 500 !important;
  }
  #shopify-section-{{ section.id }} .collection-top {
    position: relative;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__count {
    color: var(--color-text);
    font-size: 11px;
    font-weight: 400;
    line-height: 1.4;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__count span {
    color: var(--color-title);
    font-weight: 500 !important;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__active-filters {
    display: block;
    margin: 0 0 22px;
    padding: 0 !important;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__active-filters .facets-remove-all {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    column-gap: 10px;
    row-gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__active-filters:not(:has(.btn--clear--item)) {
    display: none;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__active-filters .btn--clear--item {
    display: block;
    margin: 0 !important;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__active-filters .btn--clear--item .active-facets__button {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    height: auto;
    padding: 7px 11px;
    border: 1px solid #e7c58e;
    border-radius: 5px;
    background: #fffdf9;
    color: #9a5b00;
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.35;
    transition: background-color .2s ease, border-color .2s ease, color .2s ease;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__active-filters .btn--clear--item .active-facets__button::before {
    display: none;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__active-filters .btn--clear--item .active-facets__button:hover {
    border-color: #c98a32;
    background: #fff5e5;
    color: #854d00;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__active-filters .btn--clear--item .filter__label {
    display: none;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__active-filters .btn--clear--item strong {
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__active-filters .btn--clear--item i {
    margin-inline-start: 9px;
    color: currentColor;
    font-size: 12px;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__active-filters .btn--clear--all {
    display: block;
    margin: 0 !important;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__active-filters .btn--clear--all .active-facets__button {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 7px 2px;
    color: var(--color-title);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.35;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__active-filters .btn--clear--all i {
    display: none;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__active-filters .btn--clear--all .active-facets__button:hover {
    color: var(--color-hover);
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .collection-toolbar__active-filters {
      margin-bottom: 16px;
    }
  }
  #shopify-section-{{ section.id }} .collection-toolbar__sort {
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__sort-trigger {
    min-height: 42px;
    padding: 0 14px;
    border: 1px solid #eadfce;
    border-radius: 6px;
    color: var(--color-title);
    font-size: 13px;
    line-height: 1.4;
    white-space: nowrap;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__sort-trigger .dropdown-toggle__content {
    max-width: 100%;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__sort-trigger i {
    margin-inline-start: 9px;
    transition: transform .2s ease;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__sort-trigger.act i {
    transform: rotate(180deg);
  }
  #shopify-section-{{ section.id }} .collection-toolbar__sort-trigger.act:before {
    display: none;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__sort-menu {
    top: calc(100% + 8px);
    left: 0 !important;
    width: max-content;
    max-width: min(320px, calc(100vw - 30px));
    border-radius: 6px;
  }
  .lang-rtl #shopify-section-{{ section.id }} .collection-toolbar__sort-menu {
    right: 0 !important;
    left: initial !important;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__views {
    flex: 0 0 auto;
    gap: 8px;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__views a {
    flex: 0 0 42px;
    box-sizing: border-box;
    border: 1px solid #eadfce;
    background: #fffaf3;
    color: var(--color-title);
    transition: color .2s ease, background-color .2s ease, border-color .2s ease;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__views a:not(:last-child) {
    margin-right: 0;
  }
  .lang-rtl #shopify-section-{{ section.id }} .collection-toolbar__views a:not(:last-child) {
    margin-left: 0;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__views a.active,
  #shopify-section-{{ section.id }} .collection-toolbar__views a:hover {
    border-color: #111;
    background-color: #111;
    color: #fff;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__views a:focus-visible,
  #shopify-section-{{ section.id }} .collection-toolbar__sort-trigger:focus-visible,
  #shopify-section-{{ section.id }} .collection-toolbar__active-filters a:focus-visible {
    outline: 2px solid var(--color-title);
    outline-offset: 3px;
  }
  @media (min-width: 992px) {
    #shopify-section-{{ section.id }} .collection-leftsidebar .collection-filter__content,
    #shopify-section-{{ section.id }} .collection-full_width .collection-filter__content,
    #shopify-section-{{ section.id }} .collection-rightsidebar .collection-filter__content {
      padding-top: 48px;
    }
    #shopify-section-{{ section.id }} .collection-leftsidebar .collection-toolbar,
    #shopify-section-{{ section.id }} .collection-full_width .collection-toolbar {
      position: absolute;
      top: -96px;
      right: 0;
      z-index: 4;
      width: auto;
      min-height: 42px;
      gap: 16px;
    }
    #shopify-section-{{ section.id }} .collection-rightsidebar .collection-toolbar {
      position: absolute;
      top: -96px;
      left: 0;
      z-index: 4;
      width: auto;
      min-height: 42px;
      gap: 16px;
    }
    #shopify-section-{{ section.id }} .collection-leftsidebar .collection-toolbar__active-filters,
    #shopify-section-{{ section.id }} .collection-full_width .collection-toolbar__active-filters {
      position: absolute;
      top: 0;
      right: 0;
      left: 340px;
      z-index: 3;
    }
    #shopify-section-{{ section.id }} .collection-rightsidebar .collection-toolbar__active-filters {
      position: absolute;
      top: 0;
      right: 340px;
      left: 0;
      z-index: 3;
    }
  }
  @media (min-width: 992px) and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .collection-leftsidebar .collection-toolbar__active-filters,
    #shopify-section-{{ section.id }} .collection-full_width .collection-toolbar__active-filters {
      left: 310px;
    }
    #shopify-section-{{ section.id }} .collection-rightsidebar .collection-toolbar__active-filters {
      right: 310px;
    }
  }
  @media (max-width: 991px) {
    #shopify-section-{{ section.id }} .collection-toolbar {
      gap: 12px;
    }
    #shopify-section-{{ section.id }} .collection-toolbar__sort {
      flex: 1 1 auto;
    }
    #shopify-section-{{ section.id }} .collection-toolbar__sort-trigger {
      min-height: 38px;
      padding: 0 10px;
      font-size: 12px;
    }
    #shopify-section-{{ section.id }} .collection-toolbar__sort-trigger .dropdown-toggle__content {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    #shopify-section-{{ section.id }} .collection-toolbar__active-filters {
      margin-bottom: 20px;
    }
  }

  /* Phase 2: category navigation */
  #shopify-section-{{ section.id }} .collection-category__heading {
    min-height: 18px;
    margin-bottom: 12px !important;
    color: var(--color-title);
    font-size: 1.4rem;
    line-height: 1.3;
    letter-spacing: .02em;
  }
  #shopify-section-{{ section.id }} .collection-category__heading i {
    flex: 0 0 auto;
    margin-inline-end: 8px;
    font-size: 15px;
  }
  #shopify-section-{{ section.id }} .collection-category__list {
    width: 100%;
    overflow: hidden;
    border: 1px solid #eadfce;
    border-radius: 5px;
    background: #fffdfa;
  }
  #shopify-section-{{ section.id }} .collection-category__list .collection__category-item {
    margin: 0;
  }
  #shopify-section-{{ section.id }} .collection-category__list .collection__category-item + .collection__category-item {
    border-top: 1px solid #eadfce;
  }
  #shopify-section-{{ section.id }} .collection-category__list .collection__category-item a {
    position: relative;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    min-height: 40px;
    height: auto;
    margin: 0;
    padding: 9px 20px;
    background: transparent;
    color: var(--color-title);
    font-size: 1.3rem;
    font-weight: 500;
    line-height: 1.35;
    transition: background-color .2s ease, color .2s ease;
  }
  #shopify-section-{{ section.id }} .collection-category__list .collection__category-item a:hover,
  #shopify-section-{{ section.id }} .collection-category__list .collection__category-item.is-active a {
    background: #fff3e1;
    color: #a76100;
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .collection-category__list .collection__category-item a:focus-visible {
    z-index: 1;
    outline: 2px solid var(--color-title);
    outline-offset: -2px;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .active-facets .btn--clear--item {
    display: none !important;
  }

  /* Filter sidebar presentation: keep Shopify facets and their JS hooks intact. */
  #shopify-section-{{ section.id }} .sidebar-filter .heading_filter {
    min-height: 24px;
    margin: 0 0 22px !important;
    padding: 0 0 16px;
    border-bottom: 1px solid #eee7df;
    color: var(--color-title);
    font-size: 1.4rem;
    line-height: 1.35;
    letter-spacing: .02em;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .heading_filter i {
    flex: 0 0 auto;
    margin-inline-end: 8px;
    font-size: 15px;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .active-facets.facets-remove-all {
    display: block;
    margin: 0 0 22px;
    padding: 0 0 22px;
    border-bottom: 1px solid #eee7df;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .active-facets .btn--clear--all {
    display: block;
    width: 100%;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .active-facets .btn--clear--all > a {
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    height: 42px;
    min-height: 42px;
    padding: 0 16px;
    border-radius: 22px;
    background: #1c1c1c;
    color: #fff;
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.2;
    transition: background-color .2s ease, color .2s ease;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .active-facets .btn--clear--all > a:hover,
  #shopify-section-{{ section.id }} .sidebar-filter .active-facets .btn--clear--all > a:focus-visible {
    background: #a76100;
    color: #fff;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .active-facets .btn--clear--all i {
    margin-inline-end: 7px;
    font-size: 13px;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter {
    margin: 0 0 20px;
    padding: 0 0 20px;
    border-bottom: 1px solid #eee7df;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter:last-child {
    margin-bottom: 0;
    border-bottom: 0;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .facets__label {
    align-items: center;
    min-height: 21px;
    margin: 0 0 14px;
    padding: 0;
    color: var(--color-title);
    font-size: 1.3rem;
    line-height: 1.4;
    letter-spacing: .04em;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .facets__label--title {
    font-size: 1.3rem;
    line-height: 1.4;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .facets__reset {
    color: #bdb4aa;
    font-size: 1rem;
    line-height: 1.4;
    letter-spacing: .04em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .facets__reset:hover,
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .facets__reset:focus-visible {
    color: #a76100;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .facets__list {
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .facets__item {
    margin: 0 0 7px !important;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .facets__item:last-child {
    margin-bottom: 0 !important;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .facet-checkbox {
    width: 100%;
    min-height: 19px;
    margin: 0;
    color: var(--color-text);
    font-size: 1.2rem;
    line-height: 1.4;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .facet-checkbox .custom-checkbox {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 14px;
    width: 14px;
    height: 14px;
    margin-inline-end: 10px;
    border: 1px solid #d8c7b1;
    border-radius: 2px;
    background: #fffdfa;
    transition: background-color .2s ease, border-color .2s ease;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .facet-checkbox .custom-checkbox i {
    display: none;
    margin: 0;
    color: #fff;
    font-size: 9px;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .facet-checkbox > input:checked + .custom-checkbox {
    border-color: #b86d00;
    background: #b86d00;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .facet-checkbox > input:checked + .custom-checkbox i {
    display: block;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .filter-option-value {
    color: var(--color-text);
    font-size: 1.2rem;
    line-height: 1.4;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .value_count {
    margin-inline-start: auto;
    color: #8e857d;
    font-size: 1.1rem;
    font-weight: 400;
    line-height: 1.4;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .facet-checkbox:hover .filter-option-value,
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter .facet-checkbox:focus-within .filter-option-value {
    color: #a76100;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter-price .facets__price .filter__price--bar {
    margin-bottom: 48px;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter-price .facets__price .filter__price--bar__bg {
    height: 4px;
    border: 1px solid #c98a32;
    background: #fffdfa;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter-price .facets__price .progress {
    height: 4px;
    border-radius: 5px;
    background: #c27a12;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter-price .facets__price .progress-number {
    top: 14px;
    color: #8e857d;
    font-size: 1rem;
    line-height: 1.3;
  }
  #shopify-section-{{ section.id }} .sidebar-filter .js-filter-price .facets__price input[type='range']::-webkit-slider-thumb {
    width: 18px;
    height: 18px;
    border: 7px solid #fff;
    box-shadow: 0 0 0 1px #c27a12;
