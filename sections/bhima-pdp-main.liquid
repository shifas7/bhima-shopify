    { "type": "text", "id": "delivery_free_text", "label": "Free delivery line", "default": "Free Delivery" },
    { "type": "text", "id": "delivery_insured_text", "label": "Insured line", "default": "Secure / Insured Delivery" },
    { "type": "text", "id": "delivery_cod_text", "label": "Cash on delivery line", "default": "Cash on Delivery available" },
    { "type": "text", "id": "delivery_unserved_text", "label": "Unavailable message", "default": "Delivery is currently unavailable for this pincode." },
    { "type": "text", "id": "delivery_invalid_text", "label": "Invalid pincode message", "default": "Please enter a valid 6-digit pincode." },
    { "type": "text", "id": "delivery_error_text", "label": "Error message", "default": "We couldn't check this pincode just now. Please try again." },

    { "type": "header", "content": "Specifications" },
    { "type": "text", "id": "specs_title", "label": "Card title", "default": "Specifications" },
    { "type": "text", "id": "stone_type_label", "label": "Stone table — type column", "default": "Stone Type" },
