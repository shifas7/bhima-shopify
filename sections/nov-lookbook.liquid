{%- liquid 
  assign sst = section.settings

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
-%}

{% style %}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .nov-content-lookbook {
    {% if sst.round %}
      border-radius: 100%;
    {% else %}
      border-radius: {{ sst.radius }}px;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .lookbook-title {
    color: {{ sst.lb_t }};
  }
  #shopify-section-{{ section.id }} .lookbook-desc {
    color: {{ sst.lb_desc }};
  }
  #shopify-section-{{ section.id }} .lb_btn, #shopify-section-{{ section.id }} .btn_view {
    color: {{ sst.c_btn }};
    background-color: {{ sst.b_btn }};
  }
  #shopify-section-{{ section.id }} .lb_btn:hover, #shopify-section-{{ section.id }} .btn_view:hover {
    color: {{ sst.c_btn_h }} !important;
    background-color: {{ sst.b_btn_h }} !important;
  }

  #shopify-section-{{ section.id }} .countdownfree {
    --color-dot: {{ sst.cd_cd }};
  }
  #shopify-section-{{ section.id }} .data-number {
    color: {{ sst.c_cd }};
    background-color: {{ sst.bg_cd }};
    border: 1px solid {{ sst.bd_cd }};
    border-radius: {{ sst.border_radius }}px;
  }
  #shopify-section-{{ section.id }} .name-time {
    color: {{ sst.ct_cd }};
  }

  /* Bhima Special Offers: editorial split layout. The section settings,
     countdown data attributes and lookbook image picker remain unchanged. */
  #shopify-section-{{ section.id }} .bhima-special-offers-section {
    background-color: #FFFDF9;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section > [class*="container"] {
    position: relative;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-card {
    display: grid;
    grid-template-columns: minmax(0, 45%) minmax(0, 55%);
    align-items: stretch;
    width: 100%;
    min-height: clamp(420px, 34vw, 560px);
    margin: 0;
    overflow: hidden;
    border: 1px solid #E6D8C7;
    border-radius: 16px;
    background: #FFFDF9;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-content {
    display: flex;
    align-items: center;
    min-width: 0;
    padding: clamp(32px, 4.5vw, 72px) clamp(28px, 4vw, 64px);
    box-sizing: border-box;
    background: #FFFDF9;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-content .block-countdown {
    position: static;
    width: 100%;
    max-width: 560px;
    margin: 0 !important;
    padding: 0 !important;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section {
    max-width: 100%;
    margin: 0;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section .sub_title {
    margin-top: 0;
    margin-bottom: 14px !important;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section .title {
    max-width: 20ch;
    margin: 0;
    font-size: clamp(28px, 2.55vw, 40px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: 0.015em;
    text-transform: uppercase;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section .title::after {
    content: '';
    display: block;
    width: 58px;
    height: 1px;
    margin-top: 22px;
    background: #B77A18;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section .title p,
  #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section .sub_title p,
  #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section .desc p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section .sub_title p {
    line-height: 1.35;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section .desc {
    max-width: 40ch;
    margin-top: 16px !important;
    font-size: 14px;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section .desc p {
    line-height: inherit;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-image {
    display: flex;
    align-items: stretch;
    min-width: 0;
    min-height: 0;
    width: 100%;
    padding: 0;
    background: #F8F1E7;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .Look__content {
    width: 100%;
    height: 100%;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .Look__content > .row {
    display: flex;
    width: 100%;
    height: 100%;
    margin: 0;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .Look__content .item {
    display: block;
    width: 100%;
    max-width: 100%;
    flex: 0 0 100%;
    height: 100%;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .nov-content-lookbook {
    position: relative;
    width: 100%;
    height: 100% !important;
    min-height: 0;
    overflow: visible !important;
    border: 0;
    border-radius: 0;
    background: transparent;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .item-lookbook {
    z-index: 5;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .nov-content-lookbook > .position-relative {
    position: absolute !important;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .nov-content-lookbook .respone_image {
    position: absolute !important;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    padding-top: 0 !important;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .nov-content-lookbook .respone_image img {
    position: absolute !important;
    top: 0;
    left: 0;
    width: 100% !important;
    max-width: none;
    height: 100% !important;
    object-fit: cover;
    object-position: {{ sst.background_img_position | default: 'center center' }};
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .nov-content-lookbook::after {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .countdownfree {
    display: flex;
    justify-content: flex-start !important;
    gap: clamp(6px, 1vw, 12px);
    width: 100%;
    margin-top: 24px;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .countdownfree .item-time {
    display: flex;
    width: clamp(54px, 5vw, 74px);
    flex: 0 1 clamp(54px, 5vw, 74px);
    flex-direction: column;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .data-number {
    display: flex;
    width: 100%;
    height: clamp(48px, 4.5vw, 64px);
    align-items: center;
    justify-content: center;
    padding: 0;
    font-size: clamp(22px, 2.2vw, 30px);
    font-weight: 500;
    line-height: 1;
    border-radius: {{ sst.border_radius }}px;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .name-time {
    margin-top: 8px;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown > .mt-30 {
    margin-top: 26px !important;
    text-align: left !important;
  }

  #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown > .mt-30 .btn {
    min-height: 46px;
    padding: 0 26px;
    font-size: 11px;
    letter-spacing: 0.12em;
  }

  @media (min-width: 768px) and (max-width: 991px) {
    #shopify-section-{{ section.id }} .bhima-special-offers-content {
      padding: 32px 28px;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section .title {
      font-size: 28px;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .countdownfree {
      gap: 6px;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .countdownfree .item-time {
      width: 52px;
      flex-basis: 52px;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .data-number {
      height: 48px;
      font-size: 22px;
    }
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .bhima-special-offers-card {
      display: flex;
      flex-direction: column;
      min-height: 0;
      height: auto;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-content {
      display: flex;
      justify-content: center;
      width: 100%;
      padding: clamp(30px, 8vw, 44px) 20px 34px;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-content .block-countdown {
      max-width: 480px;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section {
      text-align: center;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section .sub_title {
      margin-bottom: 12px !important;
      font-size: 10px;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section .title {
      max-width: 22ch;
      margin-right: auto;
      margin-left: auto;
      font-size: clamp(24px, 7vw, 32px);
      line-height: 1.1;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section .title::after {
      margin-right: auto;
      margin-left: auto;
      margin-top: 18px;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section .desc {
      max-width: 38ch;
      margin: 15px auto 0 !important;
      font-size: 13px;
      line-height: 1.5;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .countdownfree {
      display: flex !important;
      justify-content: center !important;
      align-items: flex-start;
      flex-wrap: nowrap;
      gap: clamp(4px, 2vw, 10px);
      margin-top: 22px;
      overflow: visible;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .countdownfree .item-time {
      width: clamp(54px, 17vw, 72px);
      flex: 1 1 0;
      max-width: 72px;
      min-width: 0;
      margin-right: 0 !important;
      margin-left: 0 !important;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .countdownfree .item-time:not(:last-child)::after {
      right: clamp(-10px, -2vw, -6px);
      top: calc(50% - 12px);
      font-size: 18px;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .data-number {
      height: clamp(50px, 15vw, 62px);
      font-size: clamp(22px, 6vw, 28px);
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .name-time {
      margin-top: 7px;
      font-size: 9px;
      letter-spacing: 0.07em;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown > .mt-30 {
      margin-top: 22px !important;
      text-align: center !important;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown > .mt-30 .btn {
      display: inline-flex;
      min-height: 46px;
      width: min(190px, 100%);
      align-items: center;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-image {
      width: 100%;
      height: auto;
      flex: 0 0 auto;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .Look__content,
    #shopify-section-{{ section.id }} .bhima-special-offers-section .Look__content > .row,
    #shopify-section-{{ section.id }} .bhima-special-offers-section .Look__content .item,
    #shopify-section-{{ section.id }} .bhima-special-offers-section .nov-content-lookbook {
      height: auto !important;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .Look__content > .row {
      display: block;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .Look__content .item {
      width: 100%;
      max-width: 100%;
      padding: 0;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .nov-content-lookbook {
      aspect-ratio: 16 / 9;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .nov-content-lookbook > .position-relative {
      position: absolute !important;
      inset: 0;
      height: 100%;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .nov-content-lookbook .respone_image {
      position: absolute !important;
      inset: 0;
      height: 100% !important;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .nov-content-lookbook .respone_image img {
      object-position: {{ sst.background_img_position | default: 'center center' }};
    }
  }

  @media (max-width: 380px) {
    #shopify-section-{{ section.id }} .bhima-special-offers-content {
      padding-right: 16px;
      padding-left: 16px;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .block-countdown .title_section .title {
      font-size: 23px;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .countdownfree {
      gap: 4px;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .countdownfree .item-time {
      max-width: 66px;
    }

    #shopify-section-{{ section.id }} .bhima-special-offers-section .data-number {
      height: 50px;
      font-size: 22px;
    }
  }
{% endstyle %}
<div class="{{ class }} bhima-special-offers-section{% if section.blocks.size > sst.limit %} h_sm{% endif %}">
  <div class="{{ sst.container }}">

    {% if sst.countdown_timeend != blank %}
    <div class="bhima-special-offers-card">
      <div class="bhima-special-offers-content">
        <div class="block-countdown">
        {% render 'heading-section', sub_position: sst.subheading_position, class: 'text-center' %}
        {% if sst.countdown_timeend != blank %}
          <div class="countdownfree d-flex justify-content-center{% if sst.show_shadow %} shadow{% endif %}" data-countdown="{{ sst.countdown_timeend }}" data-show-days="{{ settings.show_day }}" data-restart="{{ settings.restart }}"></div>
        {% endif %}
        {% if sst.btn != blank %}
          <div class="mt-30 text-center">
            <a href="{{ sst.btn_link }}" class="btn btn-medium color-{{ sst.color_section }}" aria-label="{{ sst.btn }}">
              <span>{{ sst.btn }}</span>
              <i class="zmdi zmdi-long-arrow-right"></i>
            </a>
          </div>
        {% endif %}
        </div>
      </div>
      <div class="bhima-special-offers-image">
    {% endif %}

    {% if sst.countdown_timeend == blank %}
      {% render 'heading-section', sub_position: sst.subheading_position %}
    {% endif %}

    <div class="Look__content{% if sst.show_popup %} show-popup{% endif %}" data-limit="{{ sst.limit }}" data-xl="{{ sst.xl }}">
      <div class="row spacing-{{ sst.spacing }}">
      {% for block in section.blocks %}
        {% assign bst = block.settings %}
        <div class="item{% render 'number-to-col' %}{% if bst.class != blank %} {{ bst.class }}{% endif %}{% if forloop.index <= sst.limit %} show{% endif %}{% if forloop.index > sst.limit %} hide{% endif %}" data-position="{{ forloop.index }}">
          <div class="nov-content-lookbook overflow_hidden position-relative">
            <div class="position-relative">
              {% if bst.lookbook_image != blank %}
                {% render 'nov-aspect-image', image: bst.lookbook_image %}
              {% else %}
                {%- capture current -%}{% cycle 1, 2, 3 %}{%- endcapture -%}
                {{ 'collection-apparel-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}

              {% if sst.show_popup and sst.countdown_timeend == blank %}
                <div class="btn lb_btn position-absolute" data-toggle="modal" data-target="#Lookbook{{ section.id }}{{ block.id }}">
                  {{ 'sections.lookbook.shop_the_look' | t }}
                </div>
                <div id="Lookbook{{ section.id }}{{ block.id }}" class="lookbook-modal modal fade" tabindex="-1" role="dialog" aria-hidden="true">
                  <div class="modal-dialog modal-dialog-centered" role="document">
                    <div class="modal-content">
                      <div class="modal-header close-icon" data-dismiss="modal" aria-label="Close"></div>
                      <div class="modal-body Lookbook__modal">
                        <div class="row spacing-0 h-100 align-items-center align-items-lg-start">
                          <div class="col-xl-7 col-lg-8 col-md-7">
                            <div class="lookbook__thumb position-relative">
                              {% render 'nov-aspect-image', image: bst.lookbook_image %}
                              {% if bst.pin_product_1 != blank %}
                                <div class="item-lookbook position-absolute" style="top: {{ bst.pin_position_top_1 }}%; left: {{ bst.pin_position_left_1 }}%">
                                  <span class="number-lookbook active" data-position="0">+</span>
                                </div>
                              {% endif %}
                              {% if bst.pin_product_2 != blank %}
                                <div class="item-lookbook position-absolute" style="top: {{ bst.pin_position_top_2 }}%; left: {{ bst.pin_position_left_2 }}%">
                                  <span class="number-lookbook" data-position="1">+</span>
                                </div>
                              {% endif %}
                              {% if bst.pin_product_3 != blank %}
                                <div class="item-lookbook position-absolute" style="top: {{ bst.pin_position_top_3 }}%; left: {{ bst.pin_position_left_3 }}%">
                                  <span class="number-lookbook" data-position="2">+</span>
                                </div>
                              {% endif %}
                            </div>
                          </div>
                          <div class="col-xl-5 col-lg-4 col-md-5 text-center">
                            <div class="bl_product pt-40 pt-lg-30 h-100 d-flex flex flex-column">
                              {% if sst.heading_popup != blank %}
                                <div class="h_popup" style="color: {{ sst.heading_popup_c }}">{{ sst.heading_popup }}</div>
                              {% endif %}
                              {% if sst.subheading_popup != blank %}
                                <div class="sh_popup{% if sst.heading_popup != blank %} mt-15{% endif %}" style="color: {{ sst.subheading_popup_c }}">{{ sst.subheading_popup }}</div>
                              {% endif %}
                              <div class="Lookbook__carousel grid--view-items{% if sst.heading_popup != blank or sst.subheading_popup != blank %} mt-30 mt-lg-20{% endif %}">
                                {% if bst.pin_product_1 != blank %}
                                {% assign section_id = section.id | append: block.id | append: 1 %}
                                {% assign product_1 = all_products[bst.pin_product_1] %}
                                  {% render 'product-grid-item-style-1', product: product_1, section_id: section_id %}
                                {% endif %}
                                {% if bst.pin_product_2 != blank %}
                                {% assign section_id = section.id | append: block.id | append: 2 %}
                                {% assign product_2 = all_products[bst.pin_product_2] %}
                                  {% render 'product-grid-item-style-1', product: product_2, section_id: section_id %}
                                {% endif %}
                                {% if bst.pin_product_3 != blank %}
                                {% assign section_id = section.id | append: block.id | append: 3 %}
                                {% assign product_3 = all_products[bst.pin_product_3] %}
                                  {% render 'product-grid-item-style-1', product: product_3, section_id: section_id %}
                                {% endif %}
                              </div>
                              {% if sst.social %}{% render 'nov-social' %}{% endif %}
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              {% endif %}
 
              {% unless sst.show_popup %}
                {% for i in (1..3) %}
                  {% assign pin_product_id = 'pin_product_' | append: i %}
                  {% assign pin_position_top_id = 'pin_position_top_' | append: i %}
                  {% assign pin_position_left_id = 'pin_position_left_' | append: i %}

                  {% if bst[pin_product_id] != blank %}
                    {% assign product = all_products[bst[pin_product_id]] %}
                    <div class="item-lookbook position-absolute grid--view-items d-flex" style="top: {{ bst[pin_position_top_id] }}%; left: {{ bst[pin_position_left_id] }}%">
                      <span class="number-lookbook">+</span>
                      <div class="content-lookbook position-absolute">
                        <div class="lookbook-item-product">
                          <div class="product__info">
                            <div class="product__title"><a href="{{ product.url | within: collection }}">{{ product.title }}</a></div>
                            <div class="price-box mt-10">
                              {% if product.compare_at_price_min > product.price_min %}
                                <div class="price-sale d-flex flex-wrap align-items-center">
                                  <span class="special-price" data-price-grid>{{ product.variants[0].price | money }}</span>
                                  <span class="old-price" data-compare-price-grid>{{ product.variants[0].compare_at_price | money }}</span>
                                </div>
                              {% else %}
                                <div class="price-regular">
                                  <span data-price-grid>{{ product.variants[0].price | money }}</span>
                                </div>
                              {% endif %}
                            </div>
                          </div>
                          <div class="thumbnail-container{% if product.images.size > 1 %} has-multiimage{% endif %}">
                            <a href="{{ product.url | within: collection }}">
                              {% assign image_url = product.featured_image %}
                              <img src="{{ image_url | image_url: width: 1 }}" data-src="{{ image_url | image_url: width: 200, height: 200, crop: 'center' }}" class="product__thumbnail lazyload" alt="{{ image_url.alt | default: 'image' }}" width="200" height="200" style="height: auto;">
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  {% endif %}
                {% endfor %}
              {% endunless %}
            </div>
            {% if sst.countdown_timeend == blank %}
            {% unless sst.show_popup %}
              {% if bst.btn != blank or bst.title != blank or bst.desc != blank %}
                <div class="lookbook-block_text position-absolute {{ bst.bt_alignment }} {{ bst.t_pos }}">
                  {% if bst.title != blank %}
                    <div class="lookbook-title font-900">{{ bst.title }}</div>
                  {% endif %}
                  {% if bst.desc != blank %}
                    <div class="lookbook-desc{% if bst.title != blank %} mt-15{% endif %}">{{ bst.desc }}</div>
                  {% endif %}
                  {% if bst.btn != blank %}
                    <a href="{{ bst.btn_l }}" class="btn btn_view{% if bst.title != blank or bst.desc != blank %} mt-40 mt-md-20{% endif %}">
                      <span>{{ bst.btn }}</span>
                    </a>
                  {% endif %}
                </div>
              {% endif %}
            {% endunless %}
            {% endif %}
          </div>
        </div>
      {% endfor %}
      </div>
      {% if section.blocks > sst.limit %}
        <div class="text-center text-uppercase font-500 mt-20">
          <span class="btn_loadmore d-inline-flex align-items-center justify-content-center pointer">
            <span class="position-relative">{{ 'sections.lookbook.show_more_html' | t }}</span>
          </span>
        </div>
      {% endif %}
    </div>

    {% if sst.countdown_timeend != blank %}
      </div>
      </div>
    {% endif %}

