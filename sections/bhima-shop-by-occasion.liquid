{%- comment -%}
  BHIMA — Shop by Occasion.

  Five editorial, full-bleed occasion cards. Every card is a Theme Editor block
  so the merchant can replace the image, label, link, crop and small icon
  without editing Liquid. The row becomes a scroll-snap carousel below the
  desktop breakpoint; only this track scrolls horizontally.
{%- endcomment -%}

{{ 'bhima-occasion.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sst = section.settings
  assign visible_blocks = 0
  for block in section.blocks
    if block.settings.show_card
      assign visible_blocks = visible_blocks | plus: 1
    endif
  endfor
-%}

{%- if visible_blocks > 0 -%}
  {%- style -%}
    #shopify-section-{{ section.id }} {
      --occasion-gap: {{ sst.card_gap }}px;
      --occasion-radius: {{ sst.corner_radius }}px;
      --occasion-pt: {{ sst.padding_top }}px;
      --occasion-pb: {{ sst.padding_bottom }}px;
      --occasion-label-color: {{ sst.label_color }};
      --occasion-overlay-strength: {{ sst.overlay_strength | divided_by: 100.0 }};
    }
  {%- endstyle -%}

  <section class="bhima-occasion" aria-labelledby="bhima-occasion-heading-{{ section.id }}">
    <div class="bhima-occasion__inner">
      <header class="title_section text-center bhima-occasion__heading">
        <h2 id="bhima-occasion-heading-{{ section.id }}" class="title">
          {{ sst.heading | escape }}
        </h2>
      </header>

      <ul class="bhima-occasion__track" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.show_card -%}
            {%- liquid
              assign card = block.settings
              assign title = card.title | default: 'Occasion'
              assign alt_text = card.image.alt | default: title
              assign has_link = false
              if card.link != blank
                assign has_link = true
              endif
            -%}

            <li class="bhima-occasion__item" {{ block.shopify_attributes }}>
              <{% if has_link %}a href="{{ card.link }}"{% else %}div{% endif %}
                class="bhima-occasion__card{% unless has_link %} bhima-occasion__card--static{% endunless %}"
                style="--occasion-focal: {{ card.image_position }};"
                {% if has_link %}aria-label="{{ title | escape }}"{% endif %}
              >
                {%- if card.image != blank -%}
                  {{
                    card.image
                    | image_url: width: 1600
                    | image_tag:
                      loading: 'lazy',
                      widths: '320, 480, 640, 800, 1000, 1200, 1600',
                      sizes: '(min-width: 1200px) 20vw, (min-width: 992px) 25vw, 74vw',
                      class: 'bhima-occasion__image',
                      alt: alt_text
                  }}
                {%- else -%}
                  <span class="bhima-occasion__image bhima-occasion__image--empty" aria-hidden="true"></span>
                {%- endif -%}

                <span class="bhima-occasion__scrim" aria-hidden="true"></span>

                <span class="bhima-occasion__label">
                  {%- case card.icon -%}
                    {%- when 'ring' -%}
                      <svg class="bhima-occasion__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="14" r="6.2"></circle><path d="M8.1 9.7 10.4 5h3.2l2.3 4.7"></path></svg>
                    {%- when 'diya' -%}
                      <svg class="bhima-occasion__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 15.5h12M8 15.5c.8 2.2 2.1 3.2 4 3.2s3.2-1 4-3.2M12 4.2c1.2 1.4 1.3 2.6 0 3.8-1.3-1.2-1.2-2.4 0-3.8ZM12 8v3.8"></path></svg>
                    {%- when 'jewel' -%}
                      <svg class="bhima-occasion__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 3 6 5-6 13L6 8l6-5ZM6 8h12M9 6l3 2 3-2M9 6l3-3 3 3"></path></svg>
                    {%- when 'briefcase' -%}
                      <svg class="bhima-occasion__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="4" y="7.5" width="16" height="11" rx="1.5"></rect><path d="M9 7.5V5.8c0-.7.6-1.3 1.3-1.3h3.4c.7 0 1.3.6 1.3 1.3v1.7M4 12.2h16M10 12.2v1.6h4v-1.6"></path></svg>
                    {%- when 'gift' -%}
                      <svg class="bhima-occasion__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4.5 10h15v10h-15zM3.5 7h17v3h-17zM12 7v13M12 7H8.7C6.2 7 5.8 3.8 8.2 3.8 10.4 3.8 12 7 12 7Zm0 0h3.3c2.5 0 2.9-3.2.5-3.2C13.6 3.8 12 7 12 7Z"></path></svg>
                    {%- when 'custom' -%}
                      {%- if card.icon_image != blank -%}
                        {{ card.icon_image | image_url: width: 80 | image_tag: class: 'bhima-occasion__icon-image', loading: 'lazy', alt: '' }}
                      {%- endif -%}
                  {%- endcase -%}
                  <span class="bhima-occasion__label-text">{{ title | escape }}</span>
                </span>
              </{% if has_link %}a{% else %}div{% endif %}>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Shop by Occasion",
  "class": "bhima-occasion-section",
  "tag": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Occasion"
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Gap between cards",
      "default": 14
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Card corner radius",
      "default": 6
    },
    {
      "type": "range",
      "id": "overlay_strength",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Bottom gradient strength",
      "default": 60,
      "info": "A subtle bottom fade for label readability."
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#FFFDF9"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 32,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Top spacing",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 32,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 56
    }
  ],
  "blocks": [
    {
      "type": "occasion_card",
      "name": "Occasion card",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_card",
          "label": "Show this card",
          "default": true
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image",
          "info": "The image fills the whole card. Alt text falls back to the occasion title."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Occasion title",
          "default": "Weddings"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave blank to show a non-navigational card."
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "default": "center center",
          "options": [
            { "value": "left center", "label": "Left" },
            { "value": "center center", "label": "Center" },
            { "value": "right center", "label": "Right" },
            { "value": "center top", "label": "Top" },
            { "value": "center bottom", "label": "Bottom" }
          ]
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Optional icon",
          "default": "ring",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "ring", "label": "Ring" },
            { "value": "diya", "label": "Diya" },
            { "value": "jewel", "label": "Jewellery" },
            { "value": "briefcase", "label": "Briefcase" },
            { "value": "gift", "label": "Gift" },
            { "value": "custom", "label": "Custom image" }
          ]
        },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Custom icon image",
          "info": "Used when Optional icon is set to Custom image."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Occasion",
      "blocks": [
        { "type": "occasion_card", "settings": { "title": "Weddings", "icon": "ring" } },
        { "type": "occasion_card", "settings": { "title": "Festivals", "icon": "diya" } },
        { "type": "occasion_card", "settings": { "title": "Everyday", "icon": "jewel" } },
        { "type": "occasion_card", "settings": { "title": "Office", "icon": "briefcase" } },
        { "type": "occasion_card", "settings": { "title": "Gifting", "icon": "gift" } }
      ]
    }
  ]
}
{% endschema %}
