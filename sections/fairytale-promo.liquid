<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Add robust play/pause class toggling for video carousels
    const videoItems = document.querySelectorAll('.fairytale-video-item');
    videoItems.forEach(function(item) {
      const video = item.querySelector('video');
      if (video) {
        video.addEventListener('play', function() {
          item.classList.add('is-playing');
          
          // Pause all other videos
          document.querySelectorAll('.fairytale-video-item video').forEach(function(otherVideo) {
            if (otherVideo !== video && !otherVideo.paused) {
              otherVideo.pause();
            }
          });
        });
        video.addEventListener('pause', function() {
          item.classList.remove('is-playing');
        });
        /* Also catch ended state so the play button comes back */
        video.addEventListener('ended', function() {
          item.classList.remove('is-playing');
        });
      }
    });
  });
</script>
