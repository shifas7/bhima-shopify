{%- comment -%}
  BHIMA — Our Brands.

  A premium brand-mark showcase. Each brand is a Theme Editor block (logo,
  accessible name, optional link) so the merchant can add, remove, reorder or
  relink brands without touching Liquid. The marks share one gallery surface
  on larger screens and become a swipeable scroll-snap rail on mobile.
{%- endcomment -%}

{{ 'bhima-our-brands.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sst = section.settings
-%}

<section class="bhima-brands" style="--brands-logo-h: {{ sst.logo_max_height }}px;" aria-label="{{ sst.heading | strip_html | escape }}">
  <div class="bhima-brands__inner">
    {% render 'heading-section', sub_position: sst.subheading_position %}
    <div class="bhima-brands__rule" aria-hidden="true"><span></span></div>

    <div class="bhima-brands__stage">
      <ul class="bhima-brands__row" role="list" aria-label="{{ sst.heading | strip_html | escape }} logos">
        {%- for block in section.blocks -%}
          {%- liquid
            assign item = block.settings
            assign logo_alt = item.image.alt | default: item.name | default: 'Bhima brand logo'
            assign has_link = false
            if item.link != blank
              assign has_link = true
            endif
          -%}
          <li class="bhima-brands__item" {{ block.shopify_attributes }}>
            <{% if has_link %}a href="{{ item.link }}"{% else %}div{% endif %}
              class="bhima-brands__card"
              {% if has_link %}aria-label="{{ logo_alt | escape }}"{% endif %}
            >
              {%- if item.image != blank -%}
                {{
                  item.image
                  | image_url: width: 500
                  | image_tag:
                    loading: 'lazy',
                    widths: '180, 240, 320, 400, 500',
                    class: 'bhima-brands__logo',
                    alt: logo_alt
                }}
              {%- else -%}
                {{ 'hero-apparel-3' | placeholder_svg_tag: 'bhima-brands__logo placeholder-svg' }}
              {%- endif -%}
            </{% if has_link %}a{% else %}div{% endif %}>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Our Brands",
  "tag": "section",
  "class": "section-bhima-our-brands",
  "max_blocks": 10,
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Our Brands</p>"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#29231D"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Sub heading"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Sub heading color",
      "default": "#71695F"
    },
    {
      "type": "richtext",
      "id": "descheading",
      "label": "Description"
    },
    {
      "type": "color",
      "id": "descheading_color",
      "label": "Description color",
      "default": "#71695F"
    },
    {
      "type": "select",
      "id": "subheading_position",
      "label": "Sub heading position",
      "default": "bottom",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ]
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "default": "text-center",
      "options": [
        { "value": "text-left", "label": "Left" },
        { "value": "text-center", "label": "Center" },
        { "value": "text-right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "logo_max_height",
      "min": 30,
      "max": 96,
      "step": 2,
      "unit": "px",
      "label": "Max logo height",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo",
          "info": "Shown at its natural aspect ratio — never stretched or cropped."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Brand name",
          "info": "Used as the accessible label when the logo image has no alt text set."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional. Leave blank for a non-clickable logo."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Our Brands",
      "category": "Image",
      "blocks": [
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" },
        { "type": "brand" }
      ]
    }
  ]
}
{% endschema %}
