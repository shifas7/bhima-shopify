{%- if sst.sync_slide_group -%}
  {%- comment -%}
    theme.Nov_Swipercarousel sets slidesPerGroup once, from the desktop column
    count, and never overrides it per breakpoint. So a slider showing 5 cards
    (or 1.5 on a phone) still advances 6 at a time, skipping products. The init
    is shared by six sections, two of which are off limits here, so this patch
    is scoped to this section instance and gated by a setting: it copies each
    breakpoint's slidesPerView into its slidesPerGroup, leaving every other
    slider in the theme exactly as it was.
  {%- endcomment -%}
  <script>
    (function () {
      var root = document.querySelector("#shopify-section-{{ section.id }} .nov-swiper-carousel");
      if (!root) return;
      var tries = 0;
      (function wait() {
        var sw = root.swiper;
        if (!sw || !sw.params) {
          if (++tries > 40) return;          // ~4s, then give up quietly
          return setTimeout(wait, 100);
        }
        var group = function (n) { n = Math.floor(n || 1); return n < 1 ? 1 : n; };
        sw.params.slidesPerGroup = group(sw.params.slidesPerView);
        var bps = sw.params.breakpoints || {};
        Object.keys(bps).forEach(function (k) {
          if (bps[k] && bps[k].slidesPerView) bps[k].slidesPerGroup = group(bps[k].slidesPerView);
        });
        sw.update();
      })();
    })();
  </script>
{%- endif -%}

