  #shopify-section-{{ section.id }} .bhima-new-arrivals .nov-swiper-carousel .swiper-wrapper {
    align-items: flex-start;
  }

  #shopify-section-{{ section.id }} .bhima-new-arrivals .nov-swiper-carousel .swiper-slide.item {
    align-self: flex-start;
    height: auto !important;
    min-height: 0 !important;
  }

  #shopify-section-{{ section.id }} .bhima-new-arrivals .nov-swiper-carousel .swiper-slide.item > .item-product {
    display: block;
    height: auto !important;
    min-height: 0 !important;
  }

  #shopify-section-{{ section.id }} .bhima-new-arrivals .nov-swiper-carousel .product-top {
    height: auto !important;
    min-height: 0 !important;
  }

  #shopify-section-{{ section.id }} .bhima-new-arrivals .nov-swiper-carousel .product-top.ratio-11 .respone_image {
    padding-top: 100% !important;
  }

  #shopify-section-{{ section.id }} .bhima-new-arrivals .nov-swiper-carousel .product-top.ratio-34 .respone_image {
    padding-top: 133.3333% !important;
  }

  #shopify-section-{{ section.id }} .bhima-new-arrivals .nov-swiper-carousel .product-top.ratio-43 .respone_image {
    padding-top: 75% !important;
  }

  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .bhima-new-arrivals .title_section .title,
