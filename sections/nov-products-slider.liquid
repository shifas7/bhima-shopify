    #shopify-section-{{ section.id }} .bhima-new-arrivals .title_section .title p {
      font-size: 22.1px !important;
    }

    #shopify-section-{{ section.id }} .bhima-new-arrivals .title_section .title::after {
      width: 96px;
      margin-top: 10px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .bhima-new-arrivals .title_section .title,
    #shopify-section-{{ section.id }} .bhima-new-arrivals .title_section .title > *,
    #shopify-section-{{ section.id }} .bhima-new-arrivals .title_section .title p {
      font-size: 19.5px !important;
    }

    #shopify-section-{{ section.id }} .bhima-new-arrivals .title_section .title::after {
      width: 86px;
      margin-top: 9px;
    }
  }

  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} .bhima-new-arrivals .title_section {
      margin-bottom: 18px !important;
    }

    #shopify-section-{{ section.id }} .bhima-new-arrivals .collection__product-content:not([data-grid='list']) .collection-product-card .product__info {
      min-height: 96px;
      padding: 12px 12px 58px !important;
    }

    #shopify-section-{{ section.id }} .bhima-new-arrivals .collection__product-content:not([data-grid='list']) .collection-product-card .thumbnail-container > .form-btn-item-product,
    #shopify-section-{{ section.id }} .bhima-new-arrivals .collection__product-content:not([data-grid='list']) .collection-product-card .thumbnail-container > .btn-quick-add {
      bottom: 12px;
      left: 12px;
      width: calc(100% - 24px) !important;
    }
