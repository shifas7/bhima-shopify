{%- comment -%}
  BHIMA — Blog / Latest Articles.

  A premium editorial redesign of the theme's blog section. Structurally
  this keeps the exact same data source, settings and swiper wrapper as
  the stock "Vinova Blog" (nov-blog) section — only the article card
  markup and styling changes, from a large horizontal split card to a
  compact vertical editorial card (image on top, content below).
{%- endcomment -%}

{{ 'bhima-blog.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign sst = section.settings
  assign collection_blog = blogs[sst.blog]
  assign blog_limit = sst.limit

  if section.settings.ss_bg_enable
    assign bg = " bg"
  endif
  if section.settings.class_section != blank
    assign class_section = section.settings.class_section | prepend: ' '
  endif
  assign class = 'distance' | append: bg | append: ' ' | append: section.settings.background_position | append: class_section
  if sst.background_size == 'full'
    assign bg_class_full = class | prepend: ' '
  else
    assign bg_class_contain = class | prepend: ' '
  endif
-%}
{%- style -%}
  {% render 'nov-section-style' %}

  #shopify-section-{{ section.id }} .bhima-blog-card {
    border-radius: {{ sst.item_corner_radius }}px;
  }

  /* Scoped to this section only — tightens the gap between the heading
     and the article cards without touching the shared heading system
     other homepage sections rely on. */
  #shopify-section-{{ section.id }} .title_section {
    margin-bottom: 18px;
  }
{%- endstyle -%}

<div class="container-outer{{ bg_class_full }} color-{{ sst.color_section }}" data-section-id="{{ section.id }}" data-section-type="nov-swiper">
  <div class="{{ sst.container }}">
    <div class="container-inner{{ bg_class_contain }}">
      {% if sst.show_view_all_blog %}
        <div class="d-sm-flex align-items-end justify-content-between mb-55">
          {% render 'heading-section', sub_position: sst.subheading_position, class: 'mb-0' %}
          <a href="{{ collection_blog.url }}" class="link d-inline-flex align-items-center mt-xs-15">
            <span class="font-500 text-capitalize">{{ 'sections.blog.view_all_blog' | t }}</span>
            <span class="zmdi zmdi-long-arrow-right"></span>
          </a>
        </div>
      {% else %}
        {% render 'heading-section', sub_position: sst.subheading_position %}
      {% endif %}
      <div class="nov-swiper-carousel swiper bhima-blog__carousel {{ sst.dots_color }} {{ sst.arrow_color }}"
        data-autoplay="false"
        data-loop="false"
        data-row="1"
        data-row_mobile="1"
        data-items_xxl="{{ sst.xxl }}"
        data-items_xl="{{ sst.xl }}"
        data-items_lg="{{ sst.lg }}"
        data-items_md="{{ sst.md }}"
        data-items_sm="{{ sst.sm }}"
        data-items_xs="{{ sst.sm }}"
        data-spacing="{{ sst.spacing }}">
          <div class="swiper-wrapper">
            {% for article in collection_blog.articles limit: blog_limit %}
              <div class="swiper-slide item">
                <a
                  href="{{ article.url }}"
                  class="bhima-blog-card{% if sst.animate %} wow fadeInUp{% endif %}"
                  data-wow-delay="{{ forloop.index | times: 0.1 }}s"
                >
                  {% if sst.show_image %}
                    <div class="bhima-blog-card__media">
                      {% if article.image %}
                        {{
                          article.image
                          | image_url: width: 1200
                          | image_tag:
                            loading: 'lazy',
                            widths: '400, 600, 800, 1000, 1200',
                            sizes: '(min-width: 1200px) 42vw, (min-width: 768px) 90vw, 100vw',
                            class: 'bhima-blog-card__image',
                            alt: article.title
                        }}
                      {% else %}
                        {%- capture placeholder_cycle -%}{% cycle 1, 2, 3 %}{%- endcapture -%}
                        {{ 'blog-apparel-' | append: placeholder_cycle | placeholder_svg_tag: 'bhima-blog-card__image placeholder-svg' }}
                      {% endif %}
                    </div>
                  {% endif %}

                  <div class="bhima-blog-card__body">
                    <span class="bhima-blog-card__accent" aria-hidden="true"></span>

                    {% if sst.blog_show_type %}
                      {%- liquid
                        assign category_label = collection_blog.title
                        if article.tags.size > 0
                          assign category_label = article.tags.first
                        endif
                      -%}
                      <span class="bhima-blog-card__type">{{ category_label }}</span>
                    {% endif %}

                    {% if sst.blog_show_date or sst.blog_show_author %}
                      <div class="bhima-blog-card__meta">
                        {% if sst.blog_show_date %}
                          <span class="bhima-blog-card__date">{{ article.published_at | date: "%b %d, %Y" }}</span>
                        {% endif %}
                        {% if sst.blog_show_author %}
                          <span class="bhima-blog-card__author">{{ article.author }}</span>
                        {% endif %}
                      </div>
                    {% endif %}

                    <h3 class="bhima-blog-card__title">{{ article.title | truncate: 70 }}</h3>

                    {% if sst.blog_show_excerpt %}
                      <p class="bhima-blog-card__excerpt">
                        {%- if article.excerpt.size > 0 -%}
                          {{ article.excerpt | strip_html | truncate: 140 }}
                        {%- else -%}
                          {{ article.content | strip_html | truncate: 140 }}
                        {%- endif -%}
                      </p>
                    {% endif %}

                    {% if sst.show_readmore %}
                      <span class="bhima-blog-card__cta">
                        <span class="bhima-blog-card__cta-label">{{ sst.read_more_label | default: 'Read Article' }}</span>
                        <span class="bhima-blog-card__cta-arrows" aria-hidden="true">
                          <svg viewBox="0 0 24 24" focusable="false"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
                          <svg viewBox="0 0 24 24" focusable="false" class="bhima-blog-card__cta-arrow--ghost"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
                        </span>
                      </span>
                    {% endif %}
                  </div>
                </a>
              </div>
            {% else %}
              {%- for i in (1..2) -%}
                {%- capture current -%}{% cycle 1, 2, 3 %}{%- endcapture -%}
                <div class="swiper-slide item">
                  <div class="bhima-blog-card">
                    <div class="bhima-blog-card__media">
                      {{ 'blog-apparel-' | append: current | placeholder_svg_tag: 'bhima-blog-card__image placeholder-svg' }}
                    </div>
                    <div class="bhima-blog-card__body">
                      <div class="bhima-blog-card__meta"><span class="bhima-blog-card__date">Jan 01, 2026</span></div>
                      <h3 class="bhima-blog-card__title">Article title</h3>
                      <p class="bhima-blog-card__excerpt">Article excerpt goes here.</p>
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            {% endfor %}
          </div>
      </div>
    </div>
  </div>
</div>

