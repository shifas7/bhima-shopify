{%- comment -%}
  Thin-line icon set for the luxury PDP.
  Usage: {% render 'pdp-icon', icon: 'shield' %}
  All icons share a 20x20 viewBox and inherit currentColor.
{%- endcomment -%}
{%- liquid
  assign i = icon | default: 'check'
-%}
{%- comment -%}
  width/height are set as attributes so an icon can never expand to fill its
  container if a CSS size rule is ever missing. CSS always overrides them.
{%- endcomment -%}
<svg viewBox="0 0 20 20" width="20" height="20" fill="none" aria-hidden="true" focusable="false">
  {%- case i -%}
    {%- when 'check' -%}
      <path d="M4 10.5 8 14.5 16 5.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'shield' -%}
      <path d="M10 2.5 16.5 5v5.2c0 3.4-2.6 6.3-6.5 7.3-3.9-1-6.5-3.9-6.5-7.3V5L10 2.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <path d="M7.3 10.1 9.2 12l3.5-3.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'hallmark' -%}
      <circle cx="10" cy="8.4" r="5.2" stroke="currentColor" stroke-width="1.2"/>
      <path d="M10 5.9 10.8 7.6 12.6 7.9 11.3 9.2 11.6 11 10 10.1 8.4 11l.3-1.8L7.4 7.9l1.8-.3L10 5.9Z" stroke="currentColor" stroke-width="0.9" stroke-linejoin="round"/>
      <path d="M7.4 13.2 6.4 17.5l3.6-1.7 3.6 1.7-1-4.3" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
    {%- when 'certificate' -%}
      <rect x="3.2" y="3.6" width="13.6" height="10" rx="1" stroke="currentColor" stroke-width="1.2"/>
      <path d="M6.2 7h7.6M6.2 10h4.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M13.4 13.4v4l1.7-1.1 1.7 1.1v-4" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
    {%- when 'lock' -%}
      <rect x="4.4" y="8.6" width="11.2" height="8.4" rx="1.2" stroke="currentColor" stroke-width="1.2"/>
      <path d="M7.2 8.6V6.4a2.8 2.8 0 0 1 5.6 0v2.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      <circle cx="10" cy="12.6" r="1.1" fill="currentColor"/>
    {%- when 'return' -%}
      <path d="M4 9.4a6.2 6.2 0 1 1 1.7 4.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M3.4 5.6v3.9h3.9" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'truck' -%}
      <path d="M2.6 6.2h8.2v7.4H2.6z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <path d="M10.8 8.6h3.1l2.5 2.6v2.4h-5.6z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <circle cx="6.2" cy="15.2" r="1.6" stroke="currentColor" stroke-width="1.2"/>
      <circle cx="13.8" cy="15.2" r="1.6" stroke="currentColor" stroke-width="1.2"/>
    {%- when 'gem' -%}
      <path d="M6.2 3.6h7.6l3 4.1L10 16.6 3.2 7.7l3-4.1Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <path d="M3.2 7.7h13.6M7.4 7.7 10 16.6l2.6-8.9-1.3-4.1H8.7L7.4 7.7Z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
    {%- when 'scale' -%}
      <path d="M10 3.4v13.2M5.4 5.2h9.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M5.4 5.2 3 10.4h4.8L5.4 5.2ZM14.6 5.2 12.2 10.4H17l-2.4-5.2Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <path d="M7.4 16.6h5.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    {%- when 'receipt' -%}
      <path d="M5 3.2h10v13.6l-2-1.2-1.7 1.2-1.7-1.2-1.7 1.2-1.7-1.2L5 16.8z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <path d="M7.6 7h4.8M7.6 10h3.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    {%- when 'pin' -%}
      <path d="M10 17.4s5.4-4.6 5.4-8.6a5.4 5.4 0 1 0-10.8 0c0 4 5.4 8.6 5.4 8.6Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <circle cx="10" cy="8.6" r="2" stroke="currentColor" stroke-width="1.2"/>
    {%- when 'share' -%}
      <circle cx="15" cy="5" r="2.1" stroke="currentColor" stroke-width="1.2"/>
      <circle cx="5" cy="10" r="2.1" stroke="currentColor" stroke-width="1.2"/>
      <circle cx="15" cy="15" r="2.1" stroke="currentColor" stroke-width="1.2"/>
      <path d="M13.1 6 6.9 9M6.9 11l6.2 3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    {%- when 'chat' -%}
      <path d="M3.4 5.2A1.6 1.6 0 0 1 5 3.6h10a1.6 1.6 0 0 1 1.6 1.6v6.4A1.6 1.6 0 0 1 15 13.2H8.2L4.6 16v-2.8h-.4A.8.8 0 0 1 3.4 12z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <path d="M7 8.4h6M7 10.6h3.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    {%- when 'video' -%}
      <rect x="2.8" y="5.6" width="10" height="8.8" rx="1.4" stroke="currentColor" stroke-width="1.2"/>
      <path d="M12.8 10.2 17.2 7.4v5.2l-4.4-2.8Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
    {%- when 'help' -%}
      <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.2"/>
      <path d="M8.1 7.9a1.95 1.95 0 1 1 2.6 1.9c-.5.2-.7.6-.7 1.1v.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M10 13.9h.01" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
    {%- when 'bag' -%}
      <path d="M4.6 6.6h10.8l.9 10.2H3.7l.9-10.2Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <path d="M7.4 8.4V5.9a2.6 2.6 0 0 1 5.2 0v2.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    {%- when 'buyback' -%}
      <path d="M10 3.4a6.6 6.6 0 1 1-6.4 8.2" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      <path d="M3.2 8.4 3.6 12l3.5-.6" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M10 7.2v5.6M8.4 8.8h2.4a1.3 1.3 0 0 1 0 2.6H8.4" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/>
    {%- when 'care' -%}
      <path d="M3.4 13.6c2.6 2.4 6.2 2.6 9-.2 2.4-2.4 3-5.6 3.2-9-3.4.2-6.6.8-9 3.2-2.8 2.8-2.6 6.4-.2 9Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <path d="M4 16c1.6-3.4 4-6 7.4-8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    {%- when 'heart' -%}
      <path d="M10 16.4 4.6 11.2a3.4 3.4 0 0 1 4.8-4.8l.6.6.6-.6a3.4 3.4 0 1 1 4.8 4.8L10 16.4Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
    {%- when 'expand' -%}
      <path d="M7.6 3.6H3.6v4M12.4 3.6h4v4M16.4 12.4v4h-4M7.6 16.4h-4v-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'zoom' -%}
      <circle cx="9" cy="9" r="5.4" stroke="currentColor" stroke-width="1.2"/>
      <path d="m13 13 3.6 3.6M7 9h4M9 7v4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    {%- when 'play' -%}
      <path d="M7.4 5.6 14.6 10l-7.2 4.4V5.6Z" fill="currentColor"/>
    {%- when 'chevron-down' -%}
      <path d="m5 8 5 5 5-5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'chevron-right' -%}
      <path d="m8 5 5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'chevron-left' -%}
      <path d="m12 5-5 5 5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'grid' -%}
      <rect x="3.2" y="3.2" width="5.6" height="5.6" rx="1" stroke="currentColor" stroke-width="1.2"/>
      <rect x="11.2" y="3.2" width="5.6" height="5.6" rx="1" stroke="currentColor" stroke-width="1.2"/>
      <rect x="3.2" y="11.2" width="5.6" height="5.6" rx="1" stroke="currentColor" stroke-width="1.2"/>
      <rect x="11.2" y="11.2" width="5.6" height="5.6" rx="1" stroke="currentColor" stroke-width="1.2"/>
    {%- when 'arrow-right' -%}
      <path d="M3.6 10h12.8M11.6 5.2 16.4 10l-4.8 4.8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'star' -%}
      <path d="m10 3 2.2 4.5 5 .7-3.6 3.5.8 4.9L10 14.3 5.6 16.6l.8-4.9L2.8 8.2l5-.7L10 3Z" fill="currentColor"/>
    {%- when 'sparkle' -%}
      <path d="M10 3.2 11.4 8 16.4 9.4 11.4 10.8 10 15.6 8.6 10.8 3.6 9.4 8.6 8 10 3.2Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
    {%- when 'phone' -%}
      <path d="M6.4 3.6 8.2 7l-1.5 1.5a9.4 9.4 0 0 0 4.8 4.8L13 11.8l3.4 1.8v2.4a1 1 0 0 1-1.1 1C8.7 16.6 3.4 11.3 3 4.7a1 1 0 0 1 1-1.1h2.4Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
    {%- when 'clock' -%}
      <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.2"/>
      <path d="M10 6v4.2l2.8 1.7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'info' -%}
      <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.2"/>
      <path d="M10 9.2v4.2M10 6.6h.01" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
    {%- when 'ring' -%}
      <circle cx="10" cy="12.4" r="4.6" stroke="currentColor" stroke-width="1.2"/>
      <path d="m10 3.4 2.2 2.6-2.2 2.4-2.2-2.4L10 3.4Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
    {%- when 'gear' -%}
      <circle cx="10" cy="10" r="2.6" stroke="currentColor" stroke-width="1.2"/>
      <path d="M10 2.6v2M10 15.4v2M3.9 6.5l1.7 1M14.4 12.5l1.7 1M3.9 13.5l1.7-1M14.4 7.5l1.7-1" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    {%- when 'hammer' -%}
      <path d="M11.6 4.2 15.8 8.4l-1.7 1.7-4.2-4.2 1.7-1.7Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <path d="M9.4 7.6 3.6 13.4a1.4 1.4 0 0 0 0 2l1 1a1.4 1.4 0 0 0 2 0l5.8-5.8" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
    {%- when 'coins' -%}
      <ellipse cx="10" cy="5.6" rx="5.6" ry="2.4" stroke="currentColor" stroke-width="1.2"/>
      <path d="M4.4 5.6v4.2c0 1.3 2.5 2.4 5.6 2.4s5.6-1.1 5.6-2.4V5.6" stroke="currentColor" stroke-width="1.2"/>
      <path d="M4.4 9.8v4.2c0 1.3 2.5 2.4 5.6 2.4s5.6-1.1 5.6-2.4V9.8" stroke="currentColor" stroke-width="1.2"/>
    {%- when 'percent' -%}
      <path d="M15 5 5 15" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
      <circle cx="6.6" cy="6.6" r="2" stroke="currentColor" stroke-width="1.2"/>
      <circle cx="13.4" cy="13.4" r="2" stroke="currentColor" stroke-width="1.2"/>
    {%- when 'box' -%}
      <path d="M10 2.8 16.6 6v8L10 17.2 3.4 14V6L10 2.8Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <path d="M3.4 6 10 9.3 16.6 6M10 9.3v7.9" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
    {%- when 'target' -%}
      <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.2"/>
      <circle cx="10" cy="10" r="2.2" stroke="currentColor" stroke-width="1.2"/>
    {%- when 'calendar' -%}
      <rect x="3.2" y="4.6" width="13.6" height="12.2" rx="1.4" stroke="currentColor" stroke-width="1.2"/>
      <path d="M3.2 8.4h13.6M7 3.2v2.8M13 3.2v2.8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    {%- when 'check-circle' -%}
      <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.2"/>
      <path d="M6.8 10.2 9 12.4l4.2-4.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'tag' -%}
      <path d="M10.4 2.8H16a1.2 1.2 0 0 1 1.2 1.2v5.6L9.5 17.3a1.2 1.2 0 0 1-1.7 0L2.7 12.2a1.2 1.2 0 0 1 0-1.7l7.7-7.7Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
      <circle cx="13.4" cy="6.6" r="1.2" stroke="currentColor" stroke-width="1.2"/>
    {%- when 'ruler' -%}
      <rect x="2.4" y="7.2" width="15.2" height="5.6" rx="1" stroke="currentColor" stroke-width="1.2"/>
      <path d="M6 7.2v2M9 7.2v3M12 7.2v2M15 7.2v3" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
    {%- else -%}
      <path d="M4 10.5 8 14.5 16 5.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
  {%- endcase -%}
</svg>
