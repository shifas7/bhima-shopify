<ul class="site-nav">
  {% for link in linklists[mainmenu].links %}
    {%- assign child_list_handle = link.title | handleize -%}
    {%- assign has_children = false -%}
    {%- assign has_grandchildren = false -%}

    {% if linklists[child_list_handle].links != blank %}
      {%- assign has_children = true -%}
      {% for childlink in linklists[child_list_handle].links %}
        {% assign grand_child_list_handle = childlink.title | handleize %}
        {% if linklists[grand_child_list_handle].links != blank %}
          {%- assign has_grandchildren = true -%}
        {% endif %}
      {% endfor %}
    {% endif %}

    {%- assign is_active = false -%}
    {%- if link.active or link.current or link.child_active -%}
      {%- assign is_active = true -%}
    {%- endif -%}

    {%- capture nav_icon_html -%}{% render 'bhima-nav-icon', title: link.title %}{%- endcapture -%}
    {%- assign nav_icon_trimmed = nav_icon_html | strip -%}

    <li class="nav--lv1{% if has_children %} parent--lv1 site-nav--has-dropdown{% if has_grandchildren %} site-nav--has-megamenu{% endif %}{% endif %}{% if is_active %} site-nav--active{% endif %}{% if forloop.last %} last{% endif %}">
      <a class="site-nav__link--main" href="{{ link.url }}" title="{{ link.title }}">
        {%- if nav_icon_trimmed != blank -%}
          <span class="site-nav--icon" aria-hidden="true">{{ nav_icon_trimmed }}</span>
        {%- endif -%}
        <span class="site-nav--title">{{ link.title }}</span>
        {%- if has_children -%}
          <span class="site-nav--arrow" aria-hidden="true">
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M1 1L5 5L9 1" stroke="#B77A18" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        {%- endif -%}
      </a>

      {%- if has_children -%}
        {%- if has_grandchildren -%}
          {% comment %}====== APPROVED FULL-WIDTH MULTI-COLUMN MEGA MENU ======{% endcomment %}
          <div class="nav-dropdown--lv1 bhima-megamenu-panel" aria-label="{{ link.title }} submenu">
            <div class="bhima-megamenu-container">
              <div class="bhima-megamenu-grid">
                {% for childlink in linklists[child_list_handle].links %}
                  {% assign grand_child_list_handle = childlink.title | handleize %}
                  <div class="bhima-megamenu-col">
                    <div class="bhima-megamenu-heading">
                      <a href="{{ childlink.url }}" class="bhima-megamenu-heading-link">{{ childlink.title }}</a>
                      <span class="bhima-megamenu-accent" aria-hidden="true"></span>
                    </div>
                    {% if linklists[grand_child_list_handle].links != blank %}
                      <ul class="bhima-megamenu-links">
                        {% for grandchildlink in linklists[grand_child_list_handle].links %}
                          <li class="bhima-megamenu-link-item">
                            <a href="{{ grandchildlink.url }}" class="bhima-megamenu-link">{{ grandchildlink.title }}</a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            </div>
          </div>
        {%- else -%}
          {% comment %}====== STANDARD SINGLE LEVEL DROPDOWN ======{% endcomment %}
          <div class="nav-dropdown--lv1 bhima-dropdown-simple">
            <ul class="bhima-dropdown-simple__list">
              {% for childlink in linklists[child_list_handle].links %}
                <li class="bhima-dropdown-simple__item{% if childlink.active %} site-nav--active{% endif %}">
                  <a href="{{ childlink.url }}" class="bhima-dropdown-simple__link">{{ childlink.title }}</a>
                </li>
              {% endfor %}
            </ul>
          </div>
        {%- endif -%}
      {%- endif -%}
    </li>
  {% endfor %}
</ul>
