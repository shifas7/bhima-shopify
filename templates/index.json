    "nov_accordion_7Dwfnb": {
      "type": "nov-accordion",
      "blocks": {
        "content_VBnRPa": {
          "type": "content",
          "settings": {
            "banner": "shopify://shop_images/Artboard_1_copy_3.jpg",
            "link": "",
            "title": "Galleria",
            "content": "<p><strong>Galleria</strong>, a vibrant and modern space designed for the style-conscious customer. Here you’ll find chic contemporary sets, lightweight everyday wear, fusion jewellery, and trending designs curated from across India. The ambience combines sophistication with comfort, featuring boutique-style displays, soft lighting, and personalised styling guidance.<br/><strong>Perfect for young brides, office-goers, and fashion-forward jewellery lovers.</strong></p>"
          }
        },
        "content_cW4YWb": {
          "type": "content",
          "settings": {
            "banner": "shopify://shop_images/Artboard_1_bfd5d060-c2ad-4578-8e4f-c91998682e92.jpg",
            "link": "",
            "title": "Celant by Bhima",
            "content": "<p>Immerse yourself in the splendour of India’s regal artistry.<br/>The <strong>Celant room</strong> showcases rare 18K Light weight  sourced from master artisans across India. Warm tones, classic décor, and expert consultants create a luxurious environment where every piece tells a story of tradition and royal elegance.<br/><strong>A destination for connoisseurs of heritage jewellery.</strong></p>"
          }
        },
        "content_kqyXrX": {
          "type": "content",
          "settings": {
            "banner": "shopify://shop_images/Artboard_1_copy_2.jpg",
            "link": "",
            "title": "Diamond",
            "content": "<p>Enter the world of sparkle.<br/>Our <strong>Diamond Lounge</strong> is designed as an intimate, elegant space where every diamond is handpicked, certified, and showcased with care.</p><p>Discover:<br/></p><ul><li>Solitaire masterpieces     <br/></li><li>Bridal diamond collections      <br/></li><li>Cocktail rings       <br/></li><li>Signature diamond sets   <br/></li><li>IGI/GIA certified pieces</li></ul><p>Interactive viewing counters, expert consultants, and a serene ambience ensure an extraordinary diamond-buying experience.<br/><br/><strong>Where luxury shines brighter.</strong></p>"
          }
        },
        "content_pmBrUR": {
          "type": "content",
          "settings": {
            "banner": "shopify://shop_images/Artboard_1_copy.jpg",
            "link": "",
            "title": "Platinum",
            "content": "<p>The <strong>Platinum Studio</strong> celebrates purity, strength, and understated elegance. Designed with a crisp, contemporary aesthetic, this section features:  </p><ul><li>Platinum love bands    <br/></li><li>Everyday platinum wear <br/></li><li>Men’s platinum collections<br/></li><li>Rare platinum-diamond fusion pieces</li></ul><p>Timeless, modern, and refined — the Platinum Studio is a sanctuary for those who love subtle luxury.</p>"
          }
        }
      },
      "block_order": [
        "content_VBnRPa",
        "content_cW4YWb",
        "content_kqyXrX",
        "content_pmBrUR"
      ],
      "name": "Vinova Accordion",
