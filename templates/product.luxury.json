        "policy-shipping": {
          "type": "block_text",
          "settings": {
            "custom_title": "Delivery Policy",
            "icon": "truck",
            "custom_content": "<ul><li>All jewellery is <strong>custom-made by our skilled goldsmiths</strong>. Hence, please allow a minimum of <strong>15-20 working days</strong> (depending on the type of jewellery) for dispatch after receipt of <strong>cleared payment</strong>. The delivery date shown on the website is <strong>tentative</strong>, based on major cities and primary locations. Deliveries to suburban areas and interior locations across India may take longer.</li><li>Products are shipped only <strong>after full payment</strong> is received against the order, except in the case of <strong>Cash on Delivery (COD)</strong>.</li><li>All parcels are securely boxed and sealed with security tapes before dispatch from our order-processing unit. However, <strong>BHIMA Jewellery</strong> cannot be held responsible for any damage caused during transit by courier partners. Customers are strongly advised <strong>not to accept any damaged or tampered packages</strong>, as acceptance will make the recipient responsible in case of missing items.</li><li>Customers are requested to <strong>record  a video while unboxing</strong> the shipment for security and verification purposes.</li></ul>"
          }
        },
        "policy-care": {
          "type": "block_text",
          "settings": {
            "custom_title": "Care Instructions",
            "icon": "care",
            "custom_content": "<ul><li>Store each piece separately in a soft pouch to avoid scratches.</li><li>Remove jewellery before swimming, bathing or exercising.</li><li>Apply perfume, lotion and cosmetics before putting your jewellery on.</li><li>Clean gently with a soft, dry cloth. Visit any Bhima boutique for professional cleaning and polishing.</li></ul>"
          }
        }
