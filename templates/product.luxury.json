    "faq": {
      "type": "bhima-pdp-faq",
      "blocks": {
        "faq-1": {
          "type": "faq",
          "settings": {
            "question": "What is the gold purity of this piece?",
            "answer": "<p>The purity is listed under Specifications on this page and is stamped on the piece itself. All Bhima Jewellery products are crafted from genuine, certified gold, and each product clearly specifies its gold purity, such as 24K, 22K or 18K.</p>"
          }
        },
        "faq-2": {
          "type": "faq",
          "settings": {
            "question": "How is the price calculated?",
            "answer": "<p>The Price Breakup on this page shows exactly how it is built: metal value at today's gold rate, making charges, stone value where applicable, any discount, and GST. The figure you see is the figure you pay.</p>"
          }
        },
        "faq-3": {
          "type": "faq",
          "settings": {
            "question": "Is this product BIS hallmarked?",
            "answer": "<p>Yes. Every Bhima Jewellery product is BIS hallmarked and comes with proper authenticity certification, ensuring complete transparency and trust.</p>"
          }
        },
        "faq-4": {
          "type": "faq",
          "settings": {
            "question": "What is the return and exchange policy?",
            "answer": "<ul><li>100% exchange value on eligible products within 15 days from the date of delivery.</li><li>100% refund applies only in the case of manufacturing defects.</li><li>Where there is no manufacturing defect, a 10% return fee is deducted from the invoice value.</li><li>Orders above ₹1,00,000 are eligible for exchange only, not refund.</li></ul>"
          }
        },
        "faq-5": {
          "type": "faq",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>All jewellery is custom-made by our goldsmiths, so please allow a minimum of 15–20 working days for dispatch after cleared payment. Delivery dates shown are tentative and based on major cities; suburban and interior locations may take longer. Use the delivery check on this page for an estimate against your pincode.</p>"
          }
        },
        "faq-6": {
          "type": "faq",
          "settings": {
            "question": "Can I see this piece before I buy?",
            "answer": "<p>Yes. Book a video call from this page and a consultant will show you the piece up close, or visit any Bhima boutique. Product availability may vary by location.</p>"
          }
        },
        "faq-7": {
          "type": "faq",
          "settings": {
            "question": "What payment methods are accepted?",
            "answer": "<p>We accept cash, debit cards, credit cards, UPI, net banking, and other approved digital payment methods, both online and in-store.</p>"
          }
        }
      },
